i# AVA Fabric — variáveis de ambiente (TEMPLATE)
# =============================================================================
# Copie para .env e preencha. NUNCA commitar o .env preenchido — o .gitignore
# bloqueia *.env e .env.*, com exceção explícita deste arquivo.
#
# Precedência da tool Headroom (forte → fraco):
#   1. estas variáveis
#   2. projects/{project}/context/project-config.yaml → bloco `headroom:`
#   3. src/shared/tools/headroom/headroom.yaml
#
# Ver a configuração efetiva:
#   python src/shared/tools/headroom/headroom_config.py -p Meu-ERP

# ── Azure AI Foundry (endpoint Anthropic-compatible) ─────────────────────────
# ATENÇÃO: este endpoint NÃO é Azure OpenAI. É a superfície Anthropic
# (/v1/messages) do Foundry, consumida em modo BYOK pelo Copilot CLI.
# É também o upstream do proxy: o headroom não tem flag --upstream, o destino
# real vem de ANTHROPIC_TARGET_API_URL (equivalente a --anthropic-api-url).
ANTHROPIC_TARGET_API_URL=https://aif-imf-apps-prd-eus2-001.services.ai.azure.com/anthropic

# Modelo e limite de contexto usados pela compressão.
AVA_FOUNDRY_MODEL=claude-sonnet-4-6
AVA_FOUNDRY_CONTEXT_LIMIT=200000

# Deployment (wire model) no Foundry — consumido por copilot-cli-headroom.bat.
AVA_FOUNDRY_DEPLOYMENT=claude-sonnet-4-6

# A chave do Foundry NÃO fica aqui. Ela é lida do arquivo .copilot-key na raiz
# do repositório (também gitignorado), como em copilot-cli-v1.bat.

# ── Headroom · proxy interceptor ─────────────────────────────────────────────
HEADROOM_ENABLED=true
# 127.0.0.1: o proxy carrega a chave do Foundry em trânsito (Artigo VII).
# Só use 0.0.0.0 dentro de container, publicando a porta em 127.0.0.1.
HEADROOM_HOST=127.0.0.1
HEADROOM_PORT=8787
HEADROOM_BACKEND=anthropic
# token = máxima compressão | cache = maximiza prefix-cache do provedor
HEADROOM_MODE=token
HEADROOM_TELEMETRY=off
HEADROOM_LOG_FILE=.headroom/proxy-requests.jsonl
HEADROOM_REQUEST_TIMEOUT=600

# Verbosity steering / effort routing (reduz tokens de SAÍDA do LLM).
HEADROOM_OUTPUT_SHAPER=1
# Fração de conversas mantidas como grupo de controle. 0.0 = tudo comprimido.
HEADROOM_OUTPUT_HOLDOUT=0.0

# Detector de tipo de conteúdo. No Windows o headroom recusa o backend nativo
# por padrão; deixe vazio para o auto e evite o aviso a cada chamada.
# Em Linux/container use: rust
# HEADROOM_DETECT_BACKEND=rust

# Keep-ratio do Kompress para texto (0.4 = mantém ~40% dos tokens).
# Vazio = o Kompress decide pelo próprio limiar (conservador).
# HEADROOM_TARGET_RATIO=

# ── Headroom · métricas do AVA Fabric ────────────────────────────────────────
# Relativo a projects/{project}/. Fica ao lado de agent-events.jsonl.
HEADROOM_METRICS_FILE=outputs/observability/headroom-metrics.jsonl

# ── GitHub Copilot ───────────────────────────────────────────────────────────
# Só necessário para `headroom wrap copilot --subscription` (Copilot hospedado).
# O fluxo padrão desta esteira é BYOK contra o Foundry — não precisa disto.
# GITHUB_TOKEN=
# GITHUB_COPILOT_API_URL=

# ── Observabilidade opcional (OpenTelemetry) ─────────────────────────────────
# Requer o extra [otel]. Sem isto, as métricas ficam só no JSONL.
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
