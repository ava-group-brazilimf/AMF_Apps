{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava-fabric/schemas/speckit-traceability-v3.schema.json",
  "title": "SpecKit Traceability v3",
  "description": "Rastreabilidade compilada com classificação backend/frontend e ordem autoritativa da F3S.",
  "type": "object",
  "required": [
    "schema_version", "project", "trace_id", "generated_at", "constitution",
    "total_tasks", "graph_checksum", "dependency_edges", "execution_order",
    "execution_waves", "entries"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string" },
    "generated_at": { "type": "string", "format": "date-time" },
    "constitution": { "type": "string", "minLength": 1 },
    "total_tasks": { "type": "integer", "minimum": 1 },
    "graph_checksum": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "dependency_edges": { "type": "array", "items": { "$ref": "#/$defs/edge" } },
    "execution_order": {
      "type": "array", "minItems": 1, "uniqueItems": true,
      "items": { "type": "string" }
    },
    "execution_waves": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "array", "minItems": 1, "uniqueItems": true,
        "items": { "type": "string" }
      }
    },
    "entries": { "type": "array", "minItems": 1, "items": { "$ref": "#/$defs/entry" } }
  },
  "$defs": {
    "edge": {
      "type": "object",
      "required": ["from", "to", "reason", "source"],
      "additionalProperties": false,
      "properties": {
        "from": { "type": "string" },
        "to": { "type": "string" },
        "reason": {
          "enum": ["explicit_task", "producer_consumer", "same_file", "group_dependency"]
        },
        "source": { "type": "string", "minLength": 1 }
      }
    },
    "entry": {
      "type": "object",
      "required": [
        "task_id", "title", "spec_id", "plan_id", "feature", "group", "task_type",
        "target_stack", "source_artifact", "source_anchor", "target_files", "action",
        "depends_on", "backend_dependencies", "acceptance", "verify_command", "priority",
        "story_points", "topological_rank", "execution_wave"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string", "pattern": "^T-[A-Z0-9]+(?:-[A-Z0-9]+)*-[0-9]{3}$" },
        "title": { "type": "string", "minLength": 1 },
        "spec_id": { "type": "string", "minLength": 1 },
        "plan_id": { "type": "string", "minLength": 1 },
        "feature": { "type": "string", "minLength": 1 },
        "group": { "type": "string", "minLength": 1 },
        "task_type": { "enum": ["backend", "frontend"] },
        "target_stack": { "type": "string", "minLength": 1 },
        "source_artifact": { "type": "string", "minLength": 1 },
        "source_anchor": { "type": "string", "minLength": 1 },
        "rule_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "api_ops": { "type": "array", "items": { "type": "string" }, "default": [] },
        "screen_id": { "type": ["string", "null"], "default": null },
        "test_ids": { "type": "array", "items": { "type": "string" }, "default": [] },
        "target_files": {
          "type": "array", "minItems": 1, "maxItems": 1,
          "items": { "type": "string" }
        },
        "action": { "enum": ["create", "update", "delete"] },
        "depends_on": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" }
        },
        "backend_dependencies": {
          "type": "array", "uniqueItems": true, "items": { "type": "string" },
          "description": "Predecessoras diretas backend de uma task frontend; vazio para tasks backend."
        },
        "acceptance": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "verify_command": { "type": "string", "minLength": 1 },
        "priority": { "enum": ["P1", "P2", "P3"] },
        "story_points": { "type": "integer", "minimum": 1, "maximum": 2 },
        "topological_rank": { "type": "integer", "minimum": 0 },
        "execution_wave": { "type": "integer", "minimum": 0 }
      }
    }
  }
}