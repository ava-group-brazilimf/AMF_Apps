{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava-fabric/schemas/speckit-plan-graph.schema.json",
  "title": "SpecKit Plan Graph",
  "description": "Contrato estruturado do plano usado para resolver ownership e dependencias sem parsear prosa Markdown. v3.1.0 adiciona o vinculo com o prototipo (screen_ids/component_ids/design_tokens/prototype_refs), a taxonomia work_kind e o verify_profile canonico. Todos os campos novos sao OPCIONAIS: um plan-graph 3.0.0 continua valido e e lido sem conversao.",
  "type": "object",
  "required": [
    "schema_version",
    "project",
    "trace_id",
    "feature",
    "spec_id",
    "plan_id",
    "migration_wave_id",
    "migration_wave_order",
    "groups",
    "files"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "enum": [
        "3.0.0",
        "3.1.0"
      ],
      "description": "3.1.0 e a versao corrente. 3.0.0 continua aceito (planos legados)."
    },
    "project": {
      "type": "string",
      "minLength": 1
    },
    "trace_id": {
      "type": "string"
    },
    "feature": {
      "type": "string",
      "pattern": "^[0-9]{3}-[a-z0-9-]+$"
    },
    "spec_id": {
      "type": "string",
      "minLength": 1
    },
    "plan_id": {
      "type": "string",
      "minLength": 1
    },
    "migration_wave_id": {
      "type": "string",
      "pattern": "^W[0-9]+$"
    },
    "migration_wave_order": {
      "type": "integer",
      "minimum": 0
    },
    "groups": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/group"
      }
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/file"
      }
    },
    "prototype_checksum": {
      "type": [
        "string",
        "null"
      ],
      "default": null,
      "description": "sha256 do index.html no momento do planejamento. Liga o plano a UMA versao do prototipo; PROTOTYPE-CHECKSUM-CONSISTENCY reprova quando o prototipo muda depois."
    }
  },
  "$defs": {
    "group": {
      "type": "object",
      "required": [
        "group",
        "target_stack",
        "scope",
        "depends_on"
      ],
      "additionalProperties": false,
      "properties": {
        "group": {
          "type": "string",
          "pattern": "^G-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "target_stack": {
          "type": "string",
          "minLength": 1
        },
        "scope": {
          "type": "string",
          "minLength": 1
        },
        "depends_on": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^G-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
          }
        },
        "verify_command": {
          "type": "string",
          "description": "Legado. Mantido para 3.0.0; normalizado contra verify_profile na compilacao."
        },
        "verify_profile": {
          "enum": [
            "frontend-build",
            "frontend-unit-test",
            "frontend-lint",
            "backend-build",
            "backend-unit-test",
            "backend-lint",
            "integration-test",
            "e2e-test",
            "accessibility-test",
            "visual-regression-test",
            "lint",
            "none"
          ],
          "description": "Perfil canonico de verificacao. Resolvido para comando real por verify_profiles.resolve() a partir da target_stack. Preferir isto a verify_command: um comando escrito em prosa nao sobrevive ao PATH (ver f4s_build_runner)."
        }
      },
      "anyOf": [
        {
          "required": [
            "verify_profile"
          ]
        },
        {
          "required": [
            "verify_command"
          ]
        }
      ]
    },
    "file": {
      "type": "object",
      "required": [
        "path",
        "action",
        "group",
        "task_type",
        "responsibility",
        "source_refs",
        "produces",
        "consumes"
      ],
      "additionalProperties": false,
      "properties": {
        "path": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "enum": [
            "create",
            "update",
            "delete"
          ]
        },
        "group": {
          "type": "string",
          "pattern": "^G-[A-Z0-9]+(?:-[A-Z0-9]+)*$"
        },
        "task_type": {
          "enum": [
            "backend",
            "frontend"
          ]
        },
        "responsibility": {
          "type": "string",
          "minLength": 1
        },
        "source_refs": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "$ref": "#/$defs/source_ref"
          }
        },
        "produces": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "consumes": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "work_kind": {
          "enum": [
            "design_system",
            "frontend_layout",
            "frontend_component",
            "frontend_page",
            "frontend_route",
            "frontend_form",
            "frontend_validation",
            "frontend_api_client",
            "frontend_state",
            "frontend_integration",
            "backend_api_contract",
            "backend_api_implementation",
            "backend_domain",
            "backend_persistence",
            "integration_test",
            "visual_regression_test",
            "accessibility_test",
            "end_to_end_test",
            "scaffold"
          ],
          "description": "Taxonomia fina do trabalho. NAO substitui task_type, que continua sendo a chave de roteamento da F4 (f4_routing.component_type_for_task aceita apenas frontend/backend); work_kind e o eixo de cobertura dos checks de frontend, API e integracao."
        },
        "verify_profile": {
          "enum": [
            "frontend-build",
            "frontend-unit-test",
            "frontend-lint",
            "backend-build",
            "backend-unit-test",
            "backend-lint",
            "integration-test",
            "e2e-test",
            "accessibility-test",
            "visual-regression-test",
            "lint",
            "none"
          ],
          "description": "Perfil canonico de verificacao. Resolvido para comando real por verify_profiles.resolve() a partir da target_stack. Preferir isto a verify_command: um comando escrito em prosa nao sobrevive ao PATH (ver f4s_build_runner)."
        },
        "screen_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Telas do prototipo cobertas por este arquivo.",
          "items": {
            "type": "string",
            "pattern": "^SCR-[A-Z0-9-]+$"
          }
        },
        "component_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Componentes do prototipo implementados por este arquivo.",
          "items": {
            "type": "string",
            "pattern": "^CMP-[A-Z0-9-]+$"
          }
        },
        "route_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Rotas configuradas por este arquivo.",
          "items": {
            "type": "string",
            "pattern": "^RTE-[A-Z0-9-]+$"
          }
        },
        "design_tokens": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Tokens de Design System materializados por este arquivo.",
          "items": {
            "type": "string",
            "pattern": "^TOK-[A-Z0-9-]+$"
          }
        },
        "flow_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "description": "Fluxos de navegacao cobertos (tasks de e2e).",
          "items": {
            "type": "string",
            "pattern": "^FLW-[A-Z0-9-]+$"
          }
        },
        "api_ops": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          },
          "description": "operationId do OpenAPI. NUNCA inventado: tem de existir no contrato."
        },
        "rule_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "test_ids": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "prototype_refs": {
          "type": "array",
          "uniqueItems": true,
          "default": [],
          "items": {
            "$ref": "#/$defs/source_ref"
          },
          "description": "Ancoras no prototipo/manifesto que este arquivo reproduz."
        }
      }
    },
    "source_ref": {
      "type": "object",
      "required": [
        "artifact",
        "anchor"
      ],
      "additionalProperties": false,
      "properties": {
        "artifact": {
          "type": "string",
          "minLength": 1
        },
        "anchor": {
          "type": "string",
          "minLength": 1
        }
      }
    }
  }
}
