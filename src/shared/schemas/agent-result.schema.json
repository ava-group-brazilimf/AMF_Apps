{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "AgentResult",
  "description": "Contrato de saída padrão para todos os agentes AVA",
  "type": "object",
  "required": ["trace_id", "agent_id", "success", "output"],
  "properties": {
    "trace_id": { "type": "string", "format": "uuid" },
    "agent_id": { "type": "string" },
    "success": { "type": "boolean" },
    "output": {
      "type": "string",
      "description": "Resumo textual do output produzido"
    },
    "artifacts": {
      "type": "array",
      "items": { "type": "string" },
      "description": "Paths de todos os artefatos gerados"
    },
    "risk": {
      "type": "object",
      "properties": {
        "level": {
          "type": "string",
          "enum": ["none", "low", "medium", "high", "critical"]
        },
        "score": { "type": "integer", "minimum": 0, "maximum": 100 },
        "findings": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": { "type": "string" },
              "description": { "type": "string" },
              "severity": { "type": "string" },
              "file": { "type": "string" },
              "line": { "type": "integer" }
            }
          }
        }
      }
    },
    "next_agent": {
      "type": "string",
      "description": "ID do próximo agente a ser acionado pelo Orchestrator"
    },
    "human_gate_required": {
      "type": "boolean",
      "description": "Se true, Orchestrator deve pausar e aguardar aprovação humana"
    },
    "metadata": {
      "type": "object",
      "properties": {
        "duration_seconds": { "type": "integer" },
        "tokens_used": { "type": "integer" },
        "completed_at": { "type": "string", "format": "date-time" },
        "model_used": { "type": "string" }
      }
    }
  }
}
