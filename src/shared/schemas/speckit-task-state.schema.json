{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://ava-fabric/schemas/speckit-task-state.schema.json",
  "title": "SpecKit Task State Ledger",
  "description": "Razao de progresso da geracao de codigo. JSON, e nao Markdown, porque o modelo tem muito menos probabilidade de reescrever ou reformatar um arquivo JSON — ver 'effective harnesses for long-running agents'. ESCRITO EXCLUSIVAMENTE POR src/shared/tools/task_ledger.py e pelo wrapper de passo da F4, a partir de exit code real. Nenhum agente escreve aqui: a auditoria de nopcommerce-02 encontrou a esteira declarando 'Build Status: PASS (Simulated)' com o dotnet build falhando, e uma matriz marcando 15/15 linhas OK para classes inexistentes. Auto-relato de conclusao e a falha que este arquivo existe para impedir. Spec: specs/039-speckit-planning-layer/.",
  "type": "object",
  "required": ["schema_version", "project", "trace_id", "traceability_checksum", "tasks"],
  "additionalProperties": false,
  "properties": {
    "schema_version": { "const": "3.0.0" },
    "project": { "type": "string", "minLength": 1 },
    "trace_id": { "type": "string" },
    "traceability_checksum": {
      "type": "string",
      "description": "SHA-256 do traceability.json no momento do --init. Divergencia significa que a espinha mudou depois da F3S; o razao fica invalido e CHK-SK-011 reprova."
    },
    "initialized_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": ["string", "null"], "format": "date-time" },
    "tasks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/task" }
    }
  },
  "$defs": {
    "task": {
      "type": "object",
      "required": [
        "task_id", "spec_id", "group", "migration_wave_id", "migration_wave_order",
        "task_type", "target_stack", "status", "attempts"
      ],
      "additionalProperties": false,
      "properties": {
        "task_id": { "type": "string", "pattern": "^T-[A-Z0-9]+(-[A-Z0-9]+)*-[0-9]{3}$" },
        "spec_id": { "type": "string" },
        "group": { "type": "string" },
        "migration_wave_id": { "type": "string", "pattern": "^W[0-9]+$" },
        "migration_wave_order": { "type": "integer", "minimum": 0 },
        "task_type": { "enum": ["backend", "frontend"] },
        "target_stack": { "type": "string" },
        "priority": { "type": "string", "enum": ["P1", "P2", "P3"], "default": "P2" },
        "depends_on": { "type": "array", "items": { "type": "string" }, "default": [] },
        "backend_dependencies": {
          "type": "array",
          "items": { "type": "string" },
          "default": []
        },
        "topological_rank": {
          "type": "integer",
          "minimum": 0,
          "description": "Posicao topologica calculada por dependency_graph.py."
        },
        "execution_wave": {
          "type": "integer",
          "minimum": 0,
          "description": "Onda de execucao; tasks da mesma onda podem futuramente executar em paralelo."
        },
        "verify_command": {
          "type": ["string", "null"],
          "description": "Comando real que o scheduler executa para provar a task."
        },
        "status": {
          "type": "string",
          "enum": ["pending", "in_progress", "verified", "failed", "blocked", "skipped"],
          "description": "Toda task nasce 'pending'. So chega a 'verified' com evidence contendo exit_code 0 — nunca por afirmacao do agente."
        },
        "acceptance": { "type": "array", "items": { "type": "string" }, "default": [] },
        "attempts": { "type": "integer", "minimum": 0, "default": 0 },
        "run_id": { "type": ["string", "null"], "default": null },
        "started_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "updated_at": { "type": ["string", "null"], "format": "date-time", "default": null },
        "files_written": { "type": "array", "items": { "type": "string" }, "default": [] },
        "evidence": {
          "oneOf": [
            { "type": "null" },
            { "$ref": "#/$defs/evidence" }
          ],
          "default": null,
          "description": "Obrigatorio quando status e 'verified' ou 'failed'. CHK-SK-012 reprova 'verified' sem evidencia."
        },
        "blocked_reason": { "type": ["string", "null"], "default": null }
      },
      "allOf": [
        {
          "if": { "properties": { "status": { "const": "verified" } }, "required": ["status"] },
          "then": {
            "properties": { "evidence": { "$ref": "#/$defs/evidence" } },
            "required": ["evidence"]
          }
        }
      ]
    },
    "evidence": {
      "type": "object",
      "required": ["command", "exit_code", "recorded_at"],
      "additionalProperties": false,
      "properties": {
        "command": { "type": "string", "minLength": 1 },
        "exit_code": { "type": "integer" },
        "log_path": { "type": ["string", "null"], "default": null },
        "checks": {
          "type": "object",
          "additionalProperties": { "type": "string" },
          "default": {},
          "description": "Resultado por suite de check, ex.: {\"speckit_traceability\": \"PASS\"}."
        },
        "recorded_at": { "type": "string", "format": "date-time" },
        "recorded_by": {
          "type": "string",
          "default": "task_ledger",
          "description": "Sempre uma ferramenta. Valor vindo de agente e recusado."
        }
      }
    }
  }
}
