/* %%app_title%% — estilos globais.
 *
 * O scaffold deliberadamente NÃO carrega um tema pré-compilado do Angular Material:
 * o caminho do arquivo de tema muda entre majors, e uma referência a arquivo
 * inexistente em `angular.json` é justamente a classe de defeito que este scaffold
 * existe para eliminar. O tema é introduzido pelo codegen de features, junto com o
 * primeiro componente Material que de fato o utiliza.
 */

:root {
  --app-font-family: system-ui, -apple-system, 'Segoe UI', Roboto, Arial, sans-serif;
  --app-bg: #ffffff;
  --app-fg: #1f2933;
}

* {
  box-sizing: border-box;
}

html,
body {
  height: 100%;
  margin: 0;
  padding: 0;
}

body {
  background: var(--app-bg);
  color: var(--app-fg);
  font-family: var(--app-font-family);
  line-height: 1.5;
}
