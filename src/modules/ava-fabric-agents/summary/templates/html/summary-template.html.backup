  const el = document.getElementById(elId);
  if(!el) return;
  el.innerHTML = items.map(g=>{
    const ok = g.ok==='true'||g.ok===true;
    return `<div class="ci ${ok?'ok2':'na'}">
      <div class="cbox">${ok?'✓':''}</div>${g.k?t(g.k):g.l}
    </div>`;
  }).join('');
}

/* ── Chips from D.arts ─────────────────────────────────────── */
function renderAgentChips(agentId, elId){
  const el = document.getElementById(elId);
  if(!el) return;
  const arts = (D.arts && D.arts[agentId]) || [];
  if(!arts.length){
    el.innerHTML = '<span style="font-size:11px;color:var(--g2)">'+t('lbl-no-artifacts')+'</span>';
    return;
  }
  el.innerHTML = arts.map(a=>chip(a.key, a.path)).join('');
}

