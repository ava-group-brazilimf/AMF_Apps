var lang = "pt";
var t = function(k){ return (I18N[lang]||{})[k] || I18N.pt[k] || k; };

/* ═══════════════════════════════════════════════════════════════
   NAVIGATION
   ═══════════════════════════════════════════════════════════════ */
function nav(id, el){
  document.querySelectorAll('.sec').forEach(s=>s.classList.remove('on'));
  document.querySelectorAll('.ni').forEach(n=>n.classList.remove('on'));
  const s = document.getElementById(id);
  if(s) s.classList.add('on');
  if(el) el.classList.add('on');
}

/* ═══════════════════════════════════════════════════════════════
   HELPERS
   ═══════════════════════════════════════════════════════════════ */
const sevBadge = sev => {
  const cls = {critico:'sc',alto:'sa',medio:'sm',baixo:'sb2',critical:'sc',high:'sa',medium:'sm',low:'sb2'};
  const lbl = {
    pt:{critico:'Crítico',alto:'Alto',medio:'Médio',baixo:'Baixo'},
    en:{critico:'Critical',alto:'High',medio:'Medium',baixo:'Low'}
  };
  const l = (lbl[lang]||lbl.pt)[sev]||sev;
  return `<span class="sv ${cls[sev]||'sb2'}">${l}</span>`;
};

const spill = s => {
  const cls = {done:'sd',running:'sr',error:'spe',pending:'si',idle:'si'};
  const lbl = () => ({done:t('status-done'),running:t('status-run'),error:t('status-err'),pending:t('status-pend'),idle:t('status-pend')})[s]||s;
  return `<span class="sp2 ${cls[s]||'si'}">${lbl()}</span>`;
};

const chip = (key, path) => {
  const ext = path.includes('.') ? path.split('.').pop().toUpperCase().slice(0,4) : 'DIR';
  const icons = {MD:'📄',JSON:'{}',MMD:'〰',YML:'⚙',YAML:'⚙',CS:'#',TS:'⬡',HTML:'🌐',SQL:'🗄',DIR:'📁',PROP:'⚙'};
  const ic = icons[ext]||'📄';
  const short = key.replace(/_/g,' ');
  return `<span class="arc" title="${path}">${ic} ${short}<span class="ext">${ext}</span></span>`;
};

const ndot = (id, status) => {
  const el = document.getElementById('nd-'+id);
  if(!el) return;
  el.className = 'nd ' + (status==='done'?'ok':status==='running'?'run':'idle');
};

/* ═══════════════════════════════════════════════════════════════
   RENDER FUNCTIONS
   ═══════════════════════════════════════════════════════════════ */
function renderExecSummary(){
  var box = document.getElementById('exec-box');
  if(!box) return;
  if(D.execSummary && D.execSummary[lang]){
    box.innerHTML = D.execSummary[lang];
  } else if(D.execSummary && typeof D.execSummary === 'string'){
    box.innerHTML = D.execSummary;
  }
}

function renderKPIs(){
  document.getElementById('kpi-grid').innerHTML = D.kpis.map(k=>
    `<div class="kc${k.hi?' hi':''}">
      <div class="kl">${k.k?t(k.k):k.l}</div>
      <div class="kv ${k.c||''}">${k.v}</div>
      ${k.s?`<div class="ks">${k.sk?t(k.sk):k.s}</div>`:''}
    </div>`
  ).join('');
}

function renderFileTypes(){
  document.getElementById('tb-filetypes').innerHTML = D.fileTypes.map(f=>
    `<tr><td class="mono fw">${f.t}</td><td class="fw">${f.q}</td><td>${f.dk?t(f.dk):f.d}</td></tr>`
  ).join('');
}

function renderLayers(){
  document.getElementById('tb-layers').innerHTML = D.layers.map(l=>
    `<tr><td class="fw">${l.nk?t(l.nk):l.n}</td><td class="fw">${l.l}</td><td>${l.f}</td><td>${sevBadge(l.r)}</td></tr>`
  ).join('');
}

function renderRisks(){
  const tb = document.getElementById('tb-risks');
  if(tb) tb.innerHTML = D.risks.map(r=>
    `<tr>
      <td class="mono" style="color:var(--g2)">${r.id}</td>
      <td>${r.ck?t(r.ck):r.cat}</td><td class="fw">${r.r}</td>
      <td class="mono">${r.ev}</td><td>${sevBadge(r.sev)}</td><td>${r.a}</td>
    </tr>`
  ).join('');
  const tag = document.getElementById('risk-total-tag');
  if(tag) tag.textContent = D.risks.length + ' ' + t('lbl-riscos');
  const nb = document.getElementById('nb-risks');
  if(nb) nb.textContent = D.risks.filter(r=>r.sev==='critico').length;
}

function renderPatterns(){
