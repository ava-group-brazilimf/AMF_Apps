        <th data-i18n="th-module">Módulo</th><th data-i18n="th-scenarios">Cenários</th><th data-i18n="th-parity">Paridade</th>
        <th data-i18n="th-divs">Divergências</th><th data-i18n="th-wave-aprov">Aprovação Wave</th>
      </tr></thead><tbody id="tb-parity"></tbody></table>
    </div>
  </div>
</div>

</main>
</div><!-- /lay -->

<div class="wm">AVA Fabric · ava-summary · {{GENERATED_AT}} · trace: {{TRACE_ID}}</div>

<!-- File Detail Drawer ───────────────────────────────────────── -->
<div id="fe-overlay" onclick="closeFileDrawer()"></div>
<div id="fe-drawer">
  <div id="fe-drawer-header">
    <span id="fe-drawer-icon">📄</span>
    <span id="fe-drawer-name">—</span>
    <button id="fe-drawer-close" onclick="closeFileDrawer()">✕</button>
  </div>
  <div id="fe-drawer-body">
    <div class="fe-drow">
      <div class="fe-dlabel" data-i18n="fe-filename">Nome do arquivo</div>
      <div class="fe-dvalue" id="fe-dname">—</div>
    </div>
    <div class="fe-drow">
      <div class="fe-dlabel" data-i18n="fe-ext">Extensão</div>
      <div class="fe-dvalue ext-tag" id="fe-dext">—</div>
    </div>
    <div class="fe-drow">
      <div class="fe-dlabel" data-i18n="fe-relpath">Caminho relativo</div>
      <div class="fe-dvalue" id="fe-dpath">—</div>
    </div>
    <div class="fe-drow">
      <div class="fe-dlabel" data-i18n="fe-dir">Diretório</div>
      <div class="fe-dvalue" id="fe-ddir">—</div>
    </div>
    <div style="display:flex;gap:8px;margin-top:auto">
      <button id="fe-view-btn" onclick="viewFileContent()" data-i18n="fe-view" style="flex:1;background:var(--d3);border:1px solid var(--wb);color:var(--fg);padding:9px 12px;border-radius:var(--rad);cursor:pointer;font-size:12px;font-weight:600;transition:border-color var(--tr)">👁 Visualizar</button>
      <button id="fe-copy-btn" onclick="copyFilePath()" data-i18n="fe-copy" style="flex:1">📋 Copiar</button>
    </div>
  </div>
</div>

<!-- File Content Modal ──────────────────────────────────────── -->
<div id="fc-modal" onclick="if(event.target===this)closeFileContent()">
  <div id="fc-modal-box">
    <div id="fc-modal-header">
      <span id="fc-modal-icon">📄</span>
      <span id="fc-modal-title">—</span>
      <span id="fc-modal-type">—</span>
      <button id="fc-modal-close" onclick="closeFileContent()">✕</button>
    </div>
    <div id="fc-modal-body"></div>
  </div>
</div>

