  </div>
  <div class="tdiv"></div>
  <div class="tl">
    <div class="tn">AVA Fabric</div>
    <div class="ts">Agent Factory · F8 Summary</div>
  </div>
  <div class="tdiv"></div>
  <div>
    <div class="tp" id="tp-proj">{{PROJECT_NAME}}</div>
  </div>
  <span class="ttag" id="tp-tech">Delphi → .NET 8</span>
  <div class="tsp"></div>
  <button id="theme-btn" onclick="toggleTheme()" data-i18n-title="hdr-theme-title" title="Alternar tema Claro/Dark">
    <span id="theme-icon">🌙</span>
    <span id="theme-lbl" data-i18n="hdr-theme-lbl">Dark</span>
  </button>
  <div class="tmeta">
    <span><strong id="tp-date">{{GENERATED_AT}}</strong></span>
    <span><span data-i18n="hdr-coverage">Cobertura</span>: <strong style="color:var(--ok)" id="tp-cov">{{COVERAGE}}</strong></span>
    <span><span data-i18n="hdr-scope">Escopo</span>: <strong id="tp-scope">{{SCOPE}}</strong></span>
    <span class="tbadge bOk" id="tp-status" data-i18n="hdr-status">Executado</span>
  </div>
</div>

<!-- ═══ LAYOUT ═══════════════════════════════════════════════════ -->
<div id="lay">

<!-- ═══ SIDEBAR ═════════════════════════════════════════════════ -->
<nav id="sb">

  <!-- Language selector -->
  <div class="lb">
    <div class="ll" id="lbl-lang">Idioma / Language</div>
    <select class="ls" id="lsel" onchange="setLang(this.value)">
      <option value="pt">🇧🇷 Português (PT-BR)</option>
      <option value="en">🇺🇸 English (EN-US)</option>
    </select>
  </div>

  <!-- Execution run box -->
  <div class="rb">
    <div class="rrow">
      <span class="rlb" data-i18n="run-title">Execução da Esteira</span>
      <span class="rv" style="color:var(--ok)" id="run-pct">{{EXEC_PCT}}%</span>
    </div>
    <div class="rrow">
      <span class="rlb" data-i18n="run-ok">Agentes com dados</span>
      <span class="rv" style="color:var(--ok)" id="run-ok">{{AGENTS_OK}}/41</span>
    </div>
    <div class="rrow">
      <span class="rlb" data-i18n="run-pend">Pendentes</span>
      <span class="rv" style="color:var(--g2)" id="run-err">{{AGENTS_ERR}}</span>
    </div>
    <div class="rpb"><div class="rpf" id="rpf" style="width:{{EXEC_PCT}}%"></div></div>
  </div>

  <!-- Executive -->
  <div class="ng">
    <div class="nt" data-i18n="nav-exec">Resumo Executivo</div>
    <div class="ni on" onclick="nav('s-kpis',this)">
