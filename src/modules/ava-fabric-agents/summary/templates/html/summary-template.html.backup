  ],

  /* ── Quality gates (AG-11 quality-gates.md) ─────────────────── */
  qgates:[
    {k:"qg-cov",    l:"Line coverage ≥ 80%",              ok:"{{QG1}}"},
    {k:"qg-sonar",  l:"Zero SonarQube Blocker/Critical",  ok:"{{QG2}}"},
    {k:"qg-owasp",  l:"Zero OWASP Critical CVE",          ok:"{{QG3}}"},
    {k:"qg-parity", l:"Paridade funcional ≥ 99.5%",       ok:"{{QG4}}"},
    {k:"qg-perf",   l:"Performance ≤ AS-IS baseline p95", ok:"{{QG5}}"},
    {k:"qg-client", l:"Cliente validation concluída",         ok:"{{QG6}}"},
  ],

  /* ── Migration waves (AG-13 wave-plan.md) ───────────────────── */
  waves:[
