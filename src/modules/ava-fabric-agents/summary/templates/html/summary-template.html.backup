    {m:"{{PAR2_MOD}}", scen:"{{PAR2_SCEN}}", par:"{{PAR2_PAR}}%", div:"{{PAR2_DIV}}", aprov:"{{PAR2_APROV}}"},
  ],

  /* ── Acceptance checklist (AG-36) ───────────────────────────── */
  acceptChecklist:[
    {k:"ac-parity",  l:"Paridade funcional ≥ 99.5% validada",              ok:"{{AC1}}"},
    {k:"ac-defects", l:"Zero defeitos Severity P1/P2 abertos",             ok:"{{AC2}}"},
    {k:"ac-perf",    l:"Performance igual ou melhor que AS-IS",            ok:"{{AC3}}"},
    {k:"ac-sec",     l:"Security Report: zero Critical/High",              ok:"{{AC4}}"},
    {k:"ac-criteria",l:"Todos os critérios de aceite da wave atendidos",   ok:"{{AC5}}"},
    {k:"ac-client",  l:"Cliente validou funcionalmente",            ok:"{{AC6}}"},
    {k:"ac-docs",    l:"Documentação técnica publicada na wiki",           ok:"{{AC7}}"},
    {k:"ac-handover",l:"Handover package entregue ao cliente",             ok:"{{AC8}}"},
  ],

  /* ── Diagrams (conteúdo .mmd injetado diretamente) ──────────── */
  diag:{
    c4ctx:      `{{C4_CONTEXT_DIAGRAM}}`,
    c4cnt:      `{{C4_CONTAINER_DIAGRAM}}`,
    c4comp:     `{{C4_COMPONENT_DIAGRAM}}`,
    classDiag:  `{{CLASS_DIAGRAM}}`,
    compDiag:   `{{COMPONENT_DIAGRAM}}`,
    seqBaixaCP: `{{SEQ_BAIXA_CP}}`,
    seqCadCP:   `{{SEQ_CAD_CP}}`,
    er:         `{{ER_DIAGRAM}}`,
    tobeC4:     `{{TOBE_C4_DIAGRAM}}`,
    gantt:      `{{GANTT_DIAGRAM}}`,
    solution:   `{{SOLUTION_STRUCTURE}}`,
    cleanArch:  `{{CLEAN_ARCH_STRUCTURE}}`,
  },

  /* ── Artifact inventory (AG-01..41, preenchido pelo Step 02) ── */
  /* Formato: { agentId: [{key, path}] }                          */
  arts: {{ARTIFACT_INVENTORY_JSON}},

  /* ── Agent status (done/pending por arquivo presente) ────────── */
  /* Formato: { agentId: "done"|"pending" }                        */
  agentStatus: {{AGENT_STATUS_JSON}},

  /* ── File tree (auto-descoberto via glob recursivo no Step 01) ──
     CONTRATO (não remover campos sem atualizar o agente):
       file: { name, path, ext, dir, content?, truncated? }
       - name      : string  — nome do arquivo
       - path      : string  — caminho relativo a outputs/
       - ext       : string  — extensão sem ponto
       - dir       : string  — diretório pai
       - content   : string|null — conteúdo embedado (utf-8) para texto na whitelist
                                    do Content Embedder do summary-agent. Sem este
                                    campo populado, o botão "Visualizar" do file
                                    viewer (`viewFileContent()` mais abaixo neste
                                    arquivo) fica permanentemente desabilitado.
       - truncated : boolean — true se o arquivo excedeu MAX_FILE_BYTES (256 KB)
                               ou se o agregado MAX_TOTAL_BYTES (5 MB) já foi atingido
     Estrutura recursiva: { top_key: {label, files:[file], subdirs:{key: nó}} }
  */
  fileTree: {{FILE_TREE_JSON}},
};

