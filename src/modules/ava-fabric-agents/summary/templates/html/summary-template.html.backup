    {o:"A02:2021", f:"{{OW2_FINDING}}", ev:"{{OW2_EV}}", sev:"critico", a:"{{OW2_ACT}}"},
    {o:"A09:2021", f:"{{OW3_FINDING}}", ev:"{{OW3_EV}}", sev:"medio",   a:"{{OW3_ACT}}"},
  ],

  /* ── CI stages (AG-38) ──────────────────────────────────────── */
  ciStages:[
