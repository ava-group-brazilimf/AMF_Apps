    {l:"Divergências",       k:"prk-divs",      v:"{{PARITY_DIV}}",     c:"a"},
    {l:"Waves Aprovadas",    k:"prk-approved",  v:"{{WAVES_APPROVED}}", c:"g"},
  ],
  parity:[
