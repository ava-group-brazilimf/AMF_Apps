    {id:"ava-deliverable-tech-docs",           icon:"📚", name:"AG-31 Tech Docs",          role:"Documentação técnica final", rk:"ag31-role"},
    {id:"ava-deliverable-migration-plan",      icon:"🗺", name:"AG-32 Migration Plan Pub.", role:"Plano executivo", rk:"ag32-role"},
    {id:"ava-deliverable-test-evidence",       icon:"✅", name:"AG-33 Test Evidence",      role:"Evidências de qualidade", rk:"ag33-role"},
    {id:"ava-deliverable-code-templates",      icon:"💾", name:"AG-34 Code Templates",     role:"Código e templates", rk:"ag34-role"},
    {id:"ava-deliverable-security-compliance", icon:"🔒", name:"AG-35 Security Compliance",role:"Relatório CISO", rk:"ag35-role"},
    {id:"ava-deliverable-client-demo",         icon:"🎬", name:"AG-36 Client Demo",        role:"Demo · aceite · handover", rk:"ag36-role"},
  ]},
  {num:7, label:"F7 — DevOps", lk:"ph7-label", dk:"ph7-desc", desc:"5 agentes · IaC · CI/CD · paridade", color:"var(--warn)",
   agents:[
    {id:"ava-devops-iac",             icon:"🏭", name:"AG-37 IaC",             role:"Terraform · Bicep · Ansible", rk:"ag37-role"},
    {id:"ava-devops-ci",              icon:"🔄", name:"AG-38 CI",              role:"GitHub Actions · ADO · quality gates", rk:"ag38-role"},
    {id:"ava-devops-cd",              icon:"🚀", name:"AG-39 CD",              role:"Blue-green · canary · rollback", rk:"ag39-role"},
    {id:"ava-devops-package-approval",icon:"✔",  name:"AG-40 Package Approval",role:"Validação pré-requisitos wave", rk:"ag40-role"},
    {id:"ava-devops-compare-version", icon:"⚖",  name:"AG-41 Compare Version", role:"Paridade funcional legado vs migrado", rk:"ag41-role"},
  ]},
];

function renderPhases(){
  const tl = document.getElementById('phase-timeline');
  tl.innerHTML = PHASES.map((ph,i)=>{
    const agSt = D.agentStatus||{};
    const done  = ph.agents.filter(a=>(agSt[a.id]||'pending')==='done').length;
    const total = ph.agents.length;
    const pct   = Math.round(done/total*100);
    const phSt  = pct===100?'done':pct>0?'running':'idle';

    const agCards = ph.agents.map(a=>{
      const st = agSt[a.id]||'pending';
      const arts = D.arts && D.arts[a.id] ? D.arts[a.id].length : 0;
      return `<div class="ac">
        <div class="at2">
          <div class="ai">${a.icon}</div>
          <div><div class="an">${a.name}</div><div class="ar">${a.rk?t(a.rk):a.role}</div></div>
        </div>
        <div style="display:flex;align-items:center;gap:8px;margin:4px 0">
          ${spill(st)}
          <span style="font-size:10px;color:var(--g2)">📄 ${arts} ${t('lbl-artefatos')}</span>
        </div>
      </div>`;
    }).join('');

    return `<div class="pr" id="phr${i}" onclick="tph(${i})">
      <div class="pt">
        <div class="pn ${phSt}">${ph.num}</div>
        <div>
          <div class="pname">${ph.lk?t(ph.lk):ph.label}</div>
          <div class="pdesc">${ph.dk?t(ph.dk):ph.desc}</div>
        </div>
        <div class="pmeta">
          ${spill(phSt)}
          <div class="pstat">${t('lbl-agents')}: <strong>${done}/${total}</strong></div>
          <div class="pstat">${t('lbl-progresso')}: <strong>${pct}%</strong></div>
          <span class="nb ${phSt==='done'?'ok':'warn'}">${t('lbl-expandir')}</span>
        </div>
      </div>
      <div class="pbar"><div class="pbf" style="width:${pct}%;background:${ph.color}"></div></div>
      <div class="pags"><div class="ag">${agCards}</div></div>
    </div>`;
  }).join('');
}

function tph(i){ document.getElementById('phr'+i).classList.toggle('exp') }

function renderArtifacts(){
  const wrap = document.getElementById('artifact-panels');
  const agSt = D.agentStatus||{};
  let total = 0;
  wrap.innerHTML = PHASES.map(ph=>{
    const rows = ph.agents.map(a=>{
      const arts = D.arts && D.arts[a.id] ? D.arts[a.id] : [];
      total += arts.length;
      if(!arts.length) return '';
      return `<div style="margin-bottom:12px">
        <div style="font-size:10px;color:var(--g2);margin-bottom:5px;font-weight:600">
          ${a.icon} ${a.name} — ${spill(agSt[a.id]||'pending')}
        </div>
        <div class="arl">${arts.map(ar=>chip(ar.key,ar.path)).join('')}</div>
      </div>`;
    }).filter(Boolean).join('');

    if(!rows) return '';
    const phTotal = ph.agents.reduce((s,a)=>s+(D.arts&&D.arts[a.id]?D.arts[a.id].length:0),0);
    return `<div class="cd">
      <div class="ch">
        <h2>${ph.lk?t(ph.lk):ph.label}</h2>
        <span class="ctag bOk">${phTotal} ${t('lbl-artefatos')}</span>
      </div>
      <div class="cb">${rows}</div>
    </div>`;
  }).join('');
  const nb = document.getElementById('nb-arts');
  if(nb) nb.textContent = total;
}

// ── File Explorer ─────────────────────────────────────────────
var FE_LABELS_MAP={pt:{asis:'F1 — AS-IS',tobe:'F2–F4 — TO-BE & Stack',qa:'F5 — QA',deliverables:'F6 — Entregáveis',devops:'F7 — DevOps',summary:'F8 — Summary'},en:{asis:'F1 — AS-IS',tobe:'F2–F4 — TO-BE & Stack',qa:'F5 — QA',deliverables:'F6 — Deliverables',devops:'F7 — DevOps',summary:'F8 — Summary'}};
var FE_LABELS=(FE_LABELS_MAP[lang]||FE_LABELS_MAP.pt);
const FE_ICONS={asis:'🔍',tobe:'🏗',qa:'✅',deliverables:'📦',devops:'⚙',summary:'📊'};

function _feIcon(ext){
  return ({md:'📄',json:'{}',mmd:'〰',yml:'⚙',yaml:'⚙',cs:'#',ts:'⬡',html:'🌐',sql:'🗄',tf:'⚙',py:'🐍',sln:'⚙',csproj:'⚙'})[ext.toLowerCase()]||'📄';
}
function _feCount(node){
  return (node.files||[]).length + Object.values(node.subdirs||{}).reduce((s,n)=>s+_feCount(n),0);
}
function _feChip(f){
  const fj=encodeURIComponent(JSON.stringify(f));
  return `<span class="arc fe-file-chip" title="${f.path}" onclick="openFileDrawer(decodeURIComponent('${fj}'))" data-name="${f.name.toLowerCase()}" data-ext="${f.ext.toLowerCase()}">${_feIcon(f.ext)} ${f.name}<span class="ext">${f.ext.toUpperCase()||'FILE'}</span></span>`;
}
let _feCurrentFile=null;
function openFileDrawer(fj){
  const f=typeof fj==='string'?JSON.parse(fj):fj;
  _feCurrentFile=f;
  document.getElementById('fe-drawer-icon').textContent=_feIcon(f.ext||'');
  document.getElementById('fe-drawer-name').textContent=f.name;
  document.getElementById('fe-dname').textContent=f.name;
  document.getElementById('fe-dext').textContent=(f.ext||'FILE').toUpperCase();
  document.getElementById('fe-dpath').textContent=f.path;
  document.getElementById('fe-ddir').textContent=f.dir||t('lbl-outputs-root');
  const hasContent=f.content!=null&&f.content!=='';
  const vb=document.getElementById('fe-view-btn');
  if(vb){vb.style.opacity=hasContent?'1':'.4';vb.disabled=!hasContent;vb.title=hasContent?t('lbl-view-content'):t('lbl-no-content');}
  document.getElementById('fe-drawer').classList.add('open');
  document.getElementById('fe-overlay').classList.add('open');
}
function closeFileDrawer(){
  
  document.getElementById('fe-drawer').classList.remove('open');
  document.getElementById('fe-overlay').classList.remove('open');
}
function copyFilePath(){
  const p=document.getElementById('fe-dpath').textContent;
  const _copy=(text)=>{const ta=document.createElement('textarea');ta.value=text;document.body.appendChild(ta);ta.select();document.execCommand('copy');document.body.removeChild(ta);};
  const _flash=()=>{const btn=document.getElementById('fe-copy-btn');const prev=btn.textContent;btn.textContent='✅ '+t('lbl-copied');setTimeout(()=>{btn.textContent=prev;},1500);};
  navigator.clipboard?.writeText(p).then(_flash).catch(()=>{_copy(p);_flash();});
}

// ── File Content Viewer ──────────────────────────────────────────
function viewFileContent(){
  if(!_feCurrentFile||!_feCurrentFile.content) return;
  const f=_feCurrentFile;
  document.getElementById('fc-modal-icon').textContent=_feIcon(f.ext||'');
  document.getElementById('fc-modal-title').textContent=f.name;
  document.getElementById('fc-modal-type').textContent=(f.ext||'FILE').toUpperCase();
  const body=document.getElementById('fc-modal-body');
  const ext=(f.ext||'').toLowerCase();
  body.innerHTML='';
  if(ext==='mmd'){
    _renderMmdInModal(f.content,body);
  } else if(ext==='md'){
    const div=document.createElement('div');
    div.className='md-view';
    div.innerHTML=_mdToHtml(f.content);
    body.appendChild(div);
  } else {
    const pre=document.createElement('pre');
    pre.className='code-view';
    pre.textContent=f.content;
    body.appendChild(pre);
  }
  document.getElementById('fc-modal').classList.add('open');
}
function closeFileContent(){
  document.getElementById('fc-modal').classList.remove('open');
  document.getElementById('fc-modal-body').innerHTML='';
}
function _renderMmdInModal(mmdText,container){
  container.innerHTML='<div class="mmd-view" id="fc-mmd-target"><div class="language-mermaid">'+_escHtml(mmdText)+'</div></div>';
  const pre=document.createElement('pre');
  pre.className='mermaid';
  pre.textContent=mmdText;
  container.querySelector('.mmd-view').innerHTML='';
  container.querySelector('.mmd-view').appendChild(pre);
  if(typeof mermaid!=='undefined'){
    mermaid.run({nodes:[pre]}).catch(function(e){ console.warn('[Mermaid] modal render warning:', e.message||e); });
    setTimeout(()=>{
      document.querySelectorAll('#fc-modal-body svg rect').forEach(r=>{
        const w=parseFloat(r.getAttribute('width'));
        if(!isNaN(w)&&w<0){r.setAttribute('width','0');r.setAttribute('x','0');}
      });
    },500);
  }
}
function _escHtml(t){return t.replace(/&/g,'&amp;').replace(/</g,'&lt;').replace(/>/g,'&gt;');}
function _mdToHtml(md){
  let h=md;
  // Fenced code blocks
  h=h.replace(/```(\w*)\n([\s\S]*?)```/g,(_,lang,code)=>`<pre><code class="lang-${lang}">${_escHtml(code.trim())}</code></pre>`);
  h=h.replace(/`([^`]+)`/g,(_,c)=>`<code>${_escHtml(c)}</code>`);
  // Headings
  h=h.replace(/^#### (.+)$/gm,'<h4>$1</h4>');
  h=h.replace(/^### (.+)$/gm,'<h3>$1</h3>');
  h=h.replace(/^## (.+)$/gm,'<h2>$1</h2>');
  h=h.replace(/^# (.+)$/gm,'<h1>$1</h1>');
  // Bold/italic
  h=h.replace(/\*\*(.+?)\*\*/g,'<strong>$1</strong>');
  h=h.replace(/__(.+?)__/g,'<strong>$1</strong>');
  h=h.replace(/\*(.+?)\*/g,'<em>$1</em>');
  h=h.replace(/_(.+?)_/g,'<em>$1</em>');
  // Horizontal rule
  h=h.replace(/^---+$/gm,'<hr>');
  // Blockquotes
  h=h.replace(/^> (.+)$/gm,'<blockquote>$1</blockquote>');
  // Tables (simple)
  h=h.replace(/((?:^\|.+\|\n)+)/gm,(table)=>{
    const rows=table.trim().split('\n');
    const header=rows[0];const sep=rows[1];const body=rows.slice(2);
    if(!sep||!sep.match(/^\|[\s\-|]+\|$/)) return table;
    const th=header.split('|').filter((_,i,a)=>i>0&&i<a.length-1).map(c=>`<th>${c.trim()}</th>`).join('');
    const trs=body.map(r=>`<tr>${r.split('|').filter((_,i,a)=>i>0&&i<a.length-1).map(c=>`<td>${c.trim()}</td>`).join('')}</tr>`).join('');
    return `<table><thead><tr>${th}</tr></thead><tbody>${trs}</tbody></table>`;
  });
  // Unordered lists
  h=h.replace(/((?:^[-*] .+\n?)+)/gm,(block)=>{
    const items=block.trim().split('\n').map(l=>`<li>${l.replace(/^[-*] /,'')}</li>`).join('');
    return `<ul>${items}</ul>`;
  });
  // Ordered lists
  h=h.replace(/((?:^\d+\. .+\n?)+)/gm,(block)=>{
    const items=block.trim().split('\n').map(l=>`<li>${l.replace(/^\d+\. /,'')}</li>`).join('');
    return `<ol>${items}</ol>`;
  });
  // Paragraphs (lines not already wrapped)
  h=h.replace(/^(?!<[a-zA-Z])(.+)$/gm,'<p>$1</p>');
  // Clean up empty paragraphs
  h=h.replace(/<p>\s*<\/p>/g,'');
  return h;
}
function _feSubdir(name,node,depth){
  const pad=depth*14;
  const files=(node.files||[]).map(_feChip).join('');
  const subs=Object.entries(node.subdirs||{}).map(([n,nd])=>_feSubdir(n,nd,depth+1)).join('');
  const cnt=_feCount(node);
  return `<div class="fe-subdir" style="margin-left:${pad}px">
    <div class="fe-subdir-name">📁 ${name} <span style="font-size:9px;color:var(--g2);font-weight:400;text-transform:none;letter-spacing:0;margin-left:4px">${cnt} ${t('lbl-files-short')}</span></div>
    ${files?`<div class="arl" style="margin-bottom:8px">${files}</div>`:''}
    ${subs}
  </div>`;
}
function renderFileExplorer(){
  const tree=D.fileTree||{};
  const wrap=document.getElementById('fe-panels');
  if(!wrap) return;
  const order=['asis','tobe','qa','deliverables','devops','summary'];
  const keys=[...order.filter(k=>tree[k]),...Object.keys(tree).filter(k=>!order.includes(k))];
  let total=0;
  wrap.innerHTML=keys.map(key=>{
    const node=tree[key];
    const cnt=_feCount(node);
    total+=cnt;
    const label=node.label||FE_LABELS[key]||key;
    const icon=FE_ICONS[key]||'📁';
    const rootFiles=(node.files||[]).map(_feChip).join('');
    const subs=Object.entries(node.subdirs||{}).map(([n,nd])=>_feSubdir(n,nd,0)).join('');
    return `<div class="fe-dir-card" id="fe-card-${key}">
      <div class="fe-dir-header" onclick="feToggle('${key}')">
        <span style="font-size:15px">${icon}</span>
        <div style="flex:1"><div class="fe-dir-name">${label}</div><div style="font-size:10px;color:var(--g2)">${key}/</div></div>
        <span class="fe-badge">${cnt} ${t(cnt!==1?'lbl-files':'lbl-file')}</span>
        <span class="fe-toggle" style="margin-left:8px">▾</span>
      </div>
      <div class="fe-body">
        ${rootFiles?`<div class="arl" style="margin-bottom:10px">${rootFiles}</div>`:''}
        ${subs}
        ${!cnt?'<div style="padding:18px;font-size:11px;color:var(--g2)">📭 '+t('lbl-no-files')+'</div>':''}
      </div>
    </div>`;
  }).join('');
  const nb=document.getElementById('nb-explorer');
  if(nb) nb.textContent=total;
  const fc=document.getElementById('fe-count');
  if(fc) fc.textContent=total+' '+t(total!==1?'lbl-files':'lbl-file');
}
function feToggle(key){document.getElementById('fe-card-'+key)?.classList.toggle('collapsed')}
let _feT=null;
function filterFileExplorer(q){
  clearTimeout(_feT);
  _feT=setTimeout(()=>{
    q=q.trim().toLowerCase();
    let vis=0;
    document.querySelectorAll('.fe-file-chip').forEach(c=>{
      const ok=!q||c.dataset.name.includes(q)||c.dataset.ext.includes(q)||('.'+c.dataset.ext).includes(q);
      c.classList.toggle('fe-chip-hidden',!ok);
      if(ok) vis++;
    });
    document.querySelectorAll('.fe-subdir').forEach(sd=>{
      sd.style.display=(q&&!sd.querySelectorAll('.fe-file-chip:not(.fe-chip-hidden)').length)?'none':'';
    });
    if(q) document.querySelectorAll('.fe-dir-card').forEach(card=>{
      const has=card.querySelectorAll('.fe-file-chip:not(.fe-chip-hidden)').length>0;
      card.classList.toggle('collapsed',!has);
    });
    const fc=document.getElementById('fe-count');
    if(fc) fc.textContent=vis+' '+t(vis!==1?'lbl-files':'lbl-file')+(q?' '+t(vis!==1?'lbl-found-plural':'lbl-found'):'');
  },120);
}

function renderQAAgents(){
  const el = document.getElementById('grid-qa-agents');
