<!DOCTYPE html>
<html lang="pt-BR" data-trace="{{TRACE_ID}}">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1.0">
<title>AVA Fabric Summary — {{PROJECT_NAME}}</title>
<!--
  AVA Fabric Summary Template v1.0
  Gerado por: ava-summary (F8 — Summary Module)
  Trace ID:   {{TRACE_ID}}
  Workflow:   src/modules/ava-fabric-agents/summary/workflows/generate-summary/
  Artifact map: src/modules/ava-fabric-agents/summary/data/artifact-map.yaml

  PLACEHOLDERS (substituídos pelo Step 03 do workflow):
  {{PROJECT_NAME}}      project_context.name
  {{GENERATED_AT}}      timestamp ISO
  {{COVERAGE}}          kpis.coverage
  {{SCOPE}}             project_context.scope
  {{EXEC_PCT}}          exec_summary.exec_pct (number 0-100)
  {{AGENTS_OK}}         exec_summary.agents_ok
  {{AGENTS_ERR}}        exec_summary.agents_err
  {{TRACE_ID}}          project_context.trace_id
  {{EXECUTIVE_SUMMARY}} gerado pelo agente com os dados disponíveis
  (todos os demais via objeto JS D abaixo)
-->
<style>
/* ═══ AVANADE DESIGN TOKENS ════════════════════════════════════ */
:root{
  /* Brand — Avanade Orange */
  --r:#FF5800; --rd:#CC4400; --rl:#FF7A44;
  /* Light scale (default) */
  --k:#ffffff;   --d1:#f5f5f7; --d2:#ffffff; --d3:#f0f0f4; --d4:#e8e8ec;
  /* Neutral */
  --g1:#cccccc; --g2:#888891; --g3:#555559;
  /* Text */
  --fg:#1a1a1a; --fg-dim:rgba(26,26,26,.70); --fg-muted:rgba(26,26,26,.55); --fg-faint:rgba(26,26,26,.40);
  /* Semantic */
  --ok:#00963C; --warn:#CC7A00; --info:#1565C0;
  /* Borders */
  --wb:rgba(0,0,0,.08); --wb2:rgba(0,0,0,.14);
  --rb:rgba(255,88,0,.12); --rb2:rgba(255,88,0,.05);
  /* Page bg & hover */
  --bg-page:#f4f4f7; --hover-bg:rgba(0,0,0,.04);
  /* Layout */
  --sw:264px; --hh:54px; --rad:7px; --rad2:11px;
  --tr:.16s ease;
}
html[data-theme="dark"]{
  --k:#0A0A0A; --d1:#141414; --d2:#1C1C1C; --d3:#242424; --d4:#2E2E2E;
  --g1:#3D3D3D; --g2:#6B6B6B; --g3:#9E9E9E;
  --fg:#ffffff; --fg-dim:rgba(255,255,255,.72); --fg-muted:rgba(255,255,255,.55); --fg-faint:rgba(255,255,255,.45);
  --ok:#00C864; --warn:#FFA000; --info:#2196F3;
  --wb:rgba(255,255,255,.06); --wb2:rgba(255,255,255,.12);
  --rb:rgba(255,88,0,.18); --rb2:rgba(255,88,0,.08);
  --bg-page:#0F0F0F; --hover-bg:rgba(255,255,255,.03);
}
*{box-sizing:border-box;margin:0;padding:0}
html{scroll-behavior:smooth}
body{
  font-family:'Segoe UI',system-ui,-apple-system,sans-serif;
  background:var(--bg-page); color:var(--fg); font-size:13px;
  display:flex; flex-direction:column; height:100vh; overflow:hidden;
}

/* ═══ TOPBAR ═══════════════════════════════════════════════════ */
#tb{
  height:var(--hh); background:var(--k);
  border-bottom:2px solid var(--r);
  display:flex; align-items:center; padding:0 18px; gap:12px;
  flex-shrink:0; z-index:200; position:relative;
}
.tm{
  width:34px; height:34px; background:var(--r); border-radius:6px;
  display:flex; align-items:center; justify-content:center;
  font-weight:900; font-size:17px; letter-spacing:-1px; flex-shrink:0;
}
.tl{line-height:1}
.tn{font-size:14px; font-weight:700}
.ts{font-size:9px; color:var(--r); font-weight:700; text-transform:uppercase; letter-spacing:.12em}
.tdiv{width:1px; height:26px; background:var(--wb)}
.tp{font-size:13px; font-weight:600}
.ttag{
  font-size:9px; padding:2px 8px; background:var(--d3);
  border:1px solid var(--wb); border-radius:10px; color:var(--g2);
}
.tsp{flex:1}
.tmeta{display:flex; gap:16px; align-items:center; font-size:11px; color:var(--g2)}
.tmeta strong{color:var(--fg)}
.tbadge{padding:3px 10px; border-radius:10px; font-size:10px; font-weight:700; text-transform:uppercase; letter-spacing:.07em}
.bOk  {background:rgba(0,200,100,.12); color:var(--ok);   border:1px solid rgba(0,200,100,.25)}
.bWarn{background:rgba(255,160,0,.12); color:var(--warn);  border:1px solid rgba(255,160,0,.25)}
.bCrit{background:rgba(255,0,0,.12);   color:var(--rl);    border:1px solid rgba(255,0,0,.25)}

/* ═══ LAYOUT ════════════════════════════════════════════════════ */
#lay{display:flex; flex:1; overflow:hidden}

/* ═══ SIDEBAR ═══════════════════════════════════════════════════ */
#sb{
  width:var(--sw); flex-shrink:0; background:var(--d1);
  border-right:1px solid var(--wb); overflow-y:auto; overflow-x:hidden;
}
#sb::-webkit-scrollbar{width:3px}
#sb::-webkit-scrollbar-thumb{background:var(--g1); border-radius:2px}

/* Language */
.lb{padding:12px 14px 10px; border-bottom:1px solid var(--wb)}
.ll{font-size:9px; text-transform:uppercase; letter-spacing:.1em; color:var(--g2); margin-bottom:6px}
.ls{
  width:100%; padding:7px 10px; background:var(--d3); color:var(--fg);
  border:1px solid var(--wb); border-radius:var(--rad);
  font-size:12px; cursor:pointer; outline:none; transition:border-color var(--tr);
}
.ls:focus{border-color:var(--r)}
.ls option{background:var(--d3);color:var(--fg)}

/* Run box */
.rb{padding:12px 14px; border-bottom:1px solid var(--wb)}
.rrow{display:flex; justify-content:space-between; margin-bottom:4px}
.rlb{font-size:9px; text-transform:uppercase; letter-spacing:.09em; color:var(--g2)}
.rv{font-size:11px; font-weight:700}
.rpb{height:3px; background:var(--d4); border-radius:2px; margin-top:7px; overflow:hidden}
.rpf{height:100%; background:var(--r); border-radius:2px; transition:width 1s ease}

/* Nav groups */
.ng{padding:4px 0}
.nt{
  padding:8px 14px 4px; font-size:9px; text-transform:uppercase;
  letter-spacing:.12em; color:var(--r); font-weight:700;
  display:flex; align-items:center; gap:6px;
}
.nt::after{content:''; flex:1; height:1px; background:var(--rb)}
.ni{
  display:flex; align-items:center; gap:7px;
  padding:6px 14px 6px 20px; cursor:pointer;
  color:var(--fg-muted); font-size:12px;
  border-left:2px solid transparent;
  transition:all var(--tr); user-select:none; position:relative;
}
.ni:hover{background:var(--wb); color:var(--fg)}
.ni.on{background:var(--rb2); color:var(--fg); border-left-color:var(--r)}
.nd{width:6px; height:6px; border-radius:50%; flex-shrink:0}
.nd.ok {background:var(--ok)}
.nd.run{background:var(--warn); animation:pulse 1.4s infinite}
.nd.err{background:var(--rl)}
.nd.idle{background:var(--g1)}
@keyframes pulse{0%,100%{opacity:1}50%{opacity:.35}}
.nb{
  margin-left:auto; font-size:9px; padding:1px 6px;
  border-radius:8px; font-weight:700;
}
.nb.ok  {background:rgba(0,200,100,.12); color:var(--ok)}
.nb.warn{background:rgba(255,160,0,.12); color:var(--warn)}
.nb.crit{background:rgba(255,0,0,.12);   color:var(--rl)}

/* ═══ MAIN ══════════════════════════════════════════════════════ */
#mn{
  flex:1; overflow-y:auto; background:var(--bg-page);
  padding:26px 30px 56px;
}
#mn::-webkit-scrollbar{width:5px}
#mn::-webkit-scrollbar-thumb{background:var(--g1); border-radius:3px}

/* Sections */
.sec{display:none; animation:fi .18s ease}
.sec.on{display:block}
@keyframes fi{from{opacity:0;transform:translateY(5px)}to{opacity:1;transform:none}}

/* Page header */
.ph{margin-bottom:22px}
.ph h1{font-size:21px; font-weight:700; margin-bottom:4px; line-height:1.2}
.ph p{font-size:12px; color:var(--g2); line-height:1.65}
.hl{width:44px; height:3px; background:var(--r); border-radius:2px; margin-top:10px}

/* Executive summary */
.ex{
  border-left:3px solid var(--r); background:var(--rb2);
  padding:13px 16px; border-radius:0 var(--rad) var(--rad) 0;
  margin-bottom:22px; font-size:12px; color:var(--fg-dim);
  line-height:1.75;
}

/* KPI grid */
.kg{
  display:grid; grid-template-columns:repeat(auto-fill,minmax(148px,1fr));
  gap:10px; margin-bottom:24px;
}
.kc{
  background:var(--d2); border-radius:var(--rad2);
  border:1px solid var(--wb); padding:13px 15px;
  transition:border-color var(--tr), transform var(--tr);
}
.kc:hover{border-color:var(--rd); transform:translateY(-1px)}
.kc.hi{border-color:var(--rb); background:var(--rb2)}
.kl{font-size:9px; color:var(--g2); font-weight:600; text-transform:uppercase; letter-spacing:.08em; margin-bottom:7px}
.kv{font-size:25px; font-weight:700; line-height:1}
.kv.r{color:var(--rl)} .kv.g{color:var(--ok)} .kv.a{color:var(--warn)}
.ks{font-size:10px; color:var(--g2); margin-top:4px}

/* Cards */
.cd{
  background:var(--d2); border-radius:var(--rad2);
  border:1px solid var(--wb); margin-bottom:18px; overflow:hidden;
}
.ch{
  padding:13px 17px; border-bottom:1px solid var(--wb);
  display:flex; align-items:center; gap:10px;
}
.ch h2{font-size:13px; font-weight:600}
.ctag{
  margin-left:auto; font-size:9px; padding:2px 8px;
  border-radius:10px; font-weight:700; text-transform:uppercase; letter-spacing:.06em;
}
.cb{padding:16px}

/* Table */
.at{width:100%; border-collapse:collapse; font-size:12px}
.at th{
  text-align:left; padding:8px 12px; color:var(--g2);
  font-size:9px; font-weight:700; text-transform:uppercase;
  letter-spacing:.08em; border-bottom:1px solid var(--wb);
}
.at td{
  padding:9px 12px; border-bottom:1px solid var(--wb);
  color:var(--fg-dim); vertical-align:top; line-height:1.5;
}
.at tr:last-child td{border-bottom:none}
.at tr:hover td{background:var(--hover-bg)}
.mono{font-family:'Cascadia Code','Consolas',monospace; font-size:10.5px; color:var(--fg-faint)}
.fw{font-weight:600; color:var(--fg)}

/* Severity badges */
.sv{display:inline-block; padding:2px 8px; border-radius:10px; font-size:9px; font-weight:700; text-transform:uppercase; white-space:nowrap}
.sc{background:rgba(255,0,0,.13);   color:var(--rl);   border:1px solid rgba(255,0,0,.28)}
.sa{background:rgba(255,160,0,.13); color:var(--warn);  border:1px solid rgba(255,160,0,.28)}
.sm{background:rgba(255,210,0,.1);  color:#FFD700;      border:1px solid rgba(255,210,0,.22)}
.sb2{background:rgba(0,200,100,.1); color:var(--ok);    border:1px solid rgba(0,200,100,.22)}

/* Status pills */
.sp2{display:inline-block; padding:2px 8px; border-radius:10px; font-size:9px; font-weight:700; text-transform:uppercase}
.sd {background:rgba(0,200,100,.12); color:var(--ok)}
.sr {background:rgba(255,160,0,.12); color:var(--warn)}
.spe{background:rgba(255,0,0,.12);   color:var(--rl)}
.si {background:rgba(107,107,107,.18);color:var(--g2)}

/* Agent cards */
.ag{display:grid; grid-template-columns:repeat(auto-fill,minmax(212px,1fr)); gap:9px}
.ac{
  background:var(--d3); border-radius:var(--rad);
  border:1px solid var(--wb); padding:11px 13px;
  display:flex; flex-direction:column; gap:5px;
  transition:border-color var(--tr);
}
.ac:hover{border-color:var(--rb)}
.at2{display:flex; align-items:center; gap:8px}
.ai{
  width:28px; height:28px; border-radius:6px;
  background:var(--d4); border:1px solid var(--wb);
  display:flex; align-items:center; justify-content:center;
  font-size:13px; flex-shrink:0;
}
.an{font-size:11px; font-weight:600}
.ar{font-size:10px; color:var(--g2)}

/* Artifact chips */
.arl{display:flex; flex-wrap:wrap; gap:7px}
.arc{
  display:inline-flex; align-items:center; gap:5px;
  padding:4px 10px; background:var(--d3);
  border:1px solid var(--wb); border-radius:20px;
  font-size:10px; color:var(--fg-muted);
  cursor:pointer; transition:all var(--tr); user-select:none;
}
.arc:hover{border-color:var(--r); color:var(--fg)}
.arc .ext{font-size:8px; font-weight:700; text-transform:uppercase; color:var(--r); margin-left:2px; letter-spacing:.05em}

/* Phase timeline */
.ptl{display:flex; flex-direction:column; gap:10px}
.pr{
  background:var(--d2); border-radius:var(--rad2);
  border:1px solid var(--wb); overflow:hidden; transition:border-color var(--tr);
}
.pr:hover{border-color:var(--rb)}
.pr.exp{border-color:var(--r)}
.pt{display:flex; align-items:center; gap:10px; padding:14px 16px; cursor:pointer}
.pn{
  width:30px; height:30px; border-radius:7px; font-weight:700;
  font-size:13px; display:flex; align-items:center; justify-content:center; flex-shrink:0;
}
.pn.ok  {background:var(--ok);  color:var(--k)}
.pn.run {background:var(--warn); color:var(--k)}
.pn.idle{background:var(--d4);  color:var(--g2)}
.pname{font-size:13px; font-weight:600}
.pdesc{font-size:10px; color:var(--g2); margin-top:1px}
.pmeta{margin-left:auto; display:flex; gap:12px; align-items:center}
.pstat{font-size:10px; color:var(--g2)}
.pstat strong{color:var(--fg)}
.pbar{height:3px; background:var(--d4); margin:0 16px}
.pbf{height:100%; border-radius:2px; transition:width .8s ease}
.pags{padding:14px 16px; border-top:1px solid var(--wb); display:none}
.pr.exp .pags{display:block}

/* Two-column grid */
.tc{display:grid; grid-template-columns:1fr 1fr; gap:16px}
@media(max-width:860px){.tc{grid-template-columns:1fr}}

/* Diagram box */
.diag-wrap{
  background:#fff; border:1px solid var(--wb);
  border-radius:var(--rad); padding:14px;
  overflow:auto; max-height:480px;
  cursor:zoom-in; position:relative;
}
.diag-wrap:hover::after{
  content:'🔍 clique para ampliar'; position:absolute;
  bottom:8px; right:10px; font-size:10px; color:#555;
  pointer-events:none; opacity:.7;
}
.diag-wrap pre.mermaid{margin:0}
.diag-wrap svg{max-width:100%;height:auto}
/* Fallback quando Mermaid não renderizou ainda */
.diag-wrap pre.mermaid:not([data-processed]){
  font-family:'Cascadia Code','Consolas',monospace;
  font-size:11px; color:#555;
  white-space:pre; overflow-x:auto; line-height:1.6;
}
/* Zoom modal */
#diag-modal{
  display:none; position:fixed; inset:0; z-index:9000;
  background:rgba(0,0,0,.82); cursor:zoom-out;
  align-items:center; justify-content:center;
}
#diag-modal.open{display:flex}
#diag-modal-inner{
  background:#fff; border-radius:10px;
  max-width:95vw; max-height:92vh;
  overflow:auto; padding:28px 24px 20px;
  position:relative; cursor:default;
  box-shadow:0 8px 48px rgba(0,0,0,.6);
}
#diag-modal-inner svg{max-width:100%;height:auto}
#diag-modal-close{
  position:absolute; top:8px; right:12px;
  font-size:20px; color:#444; cursor:pointer;
  background:none; border:none; line-height:1; padding:4px 8px;
  border-radius:4px;
}
#diag-modal-close:hover{background:#eee}
#diag-modal-title{
  font-size:12px; font-weight:600; color:#555;
  margin-bottom:12px; font-family:'Segoe UI',sans-serif;
}

/* Checklist */
.ck{display:flex; flex-direction:column; gap:5px}
.ci{
  display:flex; align-items:center; gap:8px; padding:7px 10px;
  background:var(--d3); border-radius:var(--rad);
  border-left:3px solid transparent;
  font-size:11.5px; color:var(--fg-muted);
}
.ci.ok2{border-left-color:var(--ok); color:var(--fg-dim)}
.ci.na {border-left-color:var(--warn)}
.ci.bl {border-left-color:var(--rl)}
.cbox{
  width:14px; height:14px; border-radius:3px; flex-shrink:0;
  border:1px solid var(--g1); display:flex; align-items:center;
  justify-content:center; font-size:9px;
}
.ci.ok2 .cbox{background:var(--ok); border-color:var(--ok); color:var(--k)}

/* Pending section notice */
.pending-notice{
  padding:28px 20px; text-align:center;
  color:var(--g2); font-size:12px; line-height:1.8;
}
.pending-notice .pi{font-size:28px; display:block; margin-bottom:8px}

/* Watermark */
.wm{
  position:fixed; bottom:10px; right:14px;
  font-size:9px; color:var(--g2); opacity:.25; pointer-events:none;
  font-family:'Consolas',monospace;
}

/* File Explorer */
#fe-search:focus{border-color:var(--r)!important}
.fe-dir-card{background:var(--d2);border-radius:var(--rad2);border:1px solid var(--wb);margin-bottom:12px;overflow:hidden}
.fe-dir-header{padding:13px 17px;border-bottom:1px solid var(--wb);display:flex;align-items:center;gap:10px;cursor:pointer;user-select:none;transition:background var(--tr)}
.fe-dir-header:hover{background:var(--hover-bg)}
.fe-dir-name{font-size:13px;font-weight:600;flex:1}
.fe-badge{font-size:9px;padding:2px 8px;border-radius:8px;font-weight:700;background:rgba(0,200,100,.12);color:var(--ok)}
.fe-toggle{font-size:10px;color:var(--g2);transition:transform var(--tr)}
.fe-dir-card.collapsed .fe-toggle{transform:rotate(-90deg)}
.fe-body{padding:14px 16px}
.fe-dir-card.collapsed .fe-body{display:none}
.fe-subdir{margin-bottom:14px}
.fe-subdir-name{font-size:10px;font-weight:700;text-transform:uppercase;letter-spacing:.08em;color:var(--g2);margin-bottom:7px;display:flex;align-items:center;gap:6px}
.fe-subdir-name::after{content:'';flex:1;height:1px;background:var(--wb)}
.fe-chip-hidden{display:none!important}
/* File detail drawer */
#fe-drawer{position:fixed;top:0;right:-360px;width:340px;height:100vh;background:var(--d2);border-left:1px solid var(--wb);z-index:200;transition:right .25s ease;display:flex;flex-direction:column;box-shadow:-4px 0 24px rgba(0,0,0,.4)}
#fe-drawer.open{right:0}
#fe-drawer-header{padding:16px 18px;border-bottom:1px solid var(--wb);display:flex;align-items:center;gap:10px}
#fe-drawer-icon{font-size:22px}
#fe-drawer-name{font-size:13px;font-weight:700;flex:1;word-break:break-all}
#fe-drawer-close{background:none;border:none;color:var(--g2);font-size:18px;cursor:pointer;padding:4px 8px;border-radius:4px;transition:color var(--tr)}
#fe-drawer-close:hover{color:var(--fg)}
#fe-drawer-body{padding:18px;overflow-y:auto;flex:1;display:flex;flex-direction:column;gap:16px}
.fe-drow{display:flex;flex-direction:column;gap:4px}
.fe-dlabel{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;color:var(--g2)}
.fe-dvalue{font-size:11px;color:var(--fg);background:var(--d3);border:1px solid var(--wb);border-radius:var(--rad);padding:7px 10px;word-break:break-all;font-family:'Consolas',monospace}
.fe-dvalue.ext-tag{display:inline-block;width:auto;background:rgba(232,0,25,.12);color:var(--r);border-color:rgba(232,0,25,.2);font-weight:700;text-transform:uppercase;padding:3px 10px;font-size:10px}
#fe-copy-btn{margin-top:auto;background:var(--r);border:none;color:#fff;padding:9px 16px;border-radius:var(--rad);cursor:pointer;font-size:12px;font-weight:600;transition:opacity var(--tr)}
#fe-copy-btn:hover{opacity:.85}
#fe-overlay{position:fixed;inset:0;background:rgba(0,0,0,.3);z-index:199;display:none}
#fe-overlay.open{display:block}
/* File Content Modal */
#fc-modal{position:fixed;inset:0;z-index:300;display:none;align-items:center;justify-content:center;padding:20px;background:rgba(0,0,0,.6)}
#fc-modal.open{display:flex}
#fc-modal-box{background:var(--d2);border:1px solid var(--wb);border-radius:var(--rad2);width:min(900px,96vw);max-height:90vh;display:flex;flex-direction:column;box-shadow:0 16px 48px rgba(0,0,0,.6);overflow:hidden}
#fc-modal-header{padding:14px 18px;border-bottom:1px solid var(--wb);display:flex;align-items:center;gap:10px;flex-shrink:0}
#fc-modal-title{font-size:14px;font-weight:700;flex:1;word-break:break-all}
#fc-modal-type{font-size:9px;font-weight:700;text-transform:uppercase;letter-spacing:.1em;padding:3px 10px;border-radius:8px;background:rgba(232,0,25,.12);color:var(--r)}
#fc-modal-close{background:none;border:none;color:var(--g2);font-size:18px;cursor:pointer;padding:4px 8px;border-radius:4px;transition:color var(--tr)}
#fc-modal-close:hover{color:var(--fg)}
#fc-modal-body{overflow-y:auto;flex:1;padding:20px}
/* Markdown renderer */
.md-view{font-size:13px;line-height:1.7;color:var(--fg)}
.md-view h1{font-size:20px;font-weight:700;margin:0 0 14px;color:var(--fg);border-bottom:1px solid var(--wb);padding-bottom:8px}
.md-view h2{font-size:16px;font-weight:700;margin:18px 0 10px;color:var(--fg)}
.md-view h3{font-size:14px;font-weight:600;margin:14px 0 8px;color:var(--fg)}
.md-view h4{font-size:13px;font-weight:600;margin:10px 0 6px;color:var(--fg-dim)}
.md-view p{margin:0 0 10px}
.md-view code{background:var(--d3);border:1px solid var(--wb);border-radius:3px;padding:1px 5px;font-family:'Consolas',monospace;font-size:11px;color:var(--info)}
.md-view pre{background:var(--d4);border:1px solid var(--wb);border-radius:var(--rad);padding:14px;overflow-x:auto;margin:0 0 12px}
.md-view pre code{background:none;border:none;padding:0;color:var(--fg-dim);font-size:11px}
.md-view ul,.md-view ol{margin:0 0 10px 20px;padding:0}
.md-view li{margin-bottom:3px}
.md-view blockquote{border-left:3px solid var(--r);padding:8px 14px;margin:0 0 10px;background:var(--hover-bg);color:var(--g2)}
.md-view table{border-collapse:collapse;width:100%;margin:0 0 12px;font-size:12px}
.md-view th{background:var(--d3);padding:7px 12px;border:1px solid var(--wb);font-weight:700;text-align:left}
.md-view td{padding:7px 12px;border:1px solid var(--wb)}
.md-view tr:nth-child(even) td{background:var(--hover-bg)}
.md-view hr{border:none;border-top:1px solid var(--wb);margin:14px 0}
.md-view strong{font-weight:700;color:var(--fg)}
.md-view em{font-style:italic;color:#d0d0d0}
/* Code viewer */
.code-view{font-family:'Consolas',monospace;font-size:11px;line-height:1.6;color:var(--fg-dim);background:var(--d4);border:1px solid var(--wb);border-radius:var(--rad);padding:16px;overflow-x:auto;white-space:pre;word-break:normal}
/* Mermaid in modal */
.mmd-view{background:#fff;border-radius:var(--rad);padding:20px;overflow:auto;text-align:center}
.mmd-view svg{max-width:100%;height:auto}
/* Avanade logo in topbar */
.tm-logo{display:flex;align-items:center;flex-shrink:0;margin-right:2px}
.tm-logo svg{height:28px;width:auto}
/* Theme toggle button */
#theme-btn{
  background:none;border:1px solid var(--wb);border-radius:var(--rad);
  padding:5px 11px;cursor:pointer;display:flex;align-items:center;
  gap:5px;font-size:11px;color:var(--fg);transition:all var(--tr);flex-shrink:0;
  font-family:inherit;
}
#theme-btn:hover{border-color:var(--r);color:var(--r)}
/* Card shadow in light mode */
html:not([data-theme="dark"]) .cd,
html:not([data-theme="dark"]) .kc,
html:not([data-theme="dark"]) .pr,
html:not([data-theme="dark"]) .ac,
html:not([data-theme="dark"]) .fe-dir-card{box-shadow:0 1px 4px rgba(0,0,0,.07)}
html:not([data-theme="dark"]) #sb{box-shadow:2px 0 8px rgba(0,0,0,.06)}
html:not([data-theme="dark"]) #tb{box-shadow:0 1px 6px rgba(0,0,0,.08)}
</style>
<!-- ═══ Theme init — must run before paint to avoid flash ═══════ -->
<script>(function(){var t=localStorage.getItem('ava-theme')||'light';document.documentElement.setAttribute('data-theme',t);})()</script>
<!-- ═══ Mermaid.js (inline — autocontido, zero CDN em runtime) ══ -->
<script>{{MERMAID_JS}}</script>
</head>
<body>

