<!-- ═══ MAIN ══════════════════════════════════════════════════════ -->
<main id="mn">

<!-- KPIs & Métricas ─────────────────────────────────────────── -->
<div id="s-kpis" class="sec on">
  <div class="ph">
    <h1><span data-i18n="pg-main-title">Análise AS-IS &amp; TO-BE</span> — <span id="ph-proj">{{PROJECT_NAME}}</span></h1>
    <p id="ph-sub"><span data-i18n="pg-main-sub-prefix">Relatório consolidado</span> · AVA Fabric Agent Factory · <strong style="color:var(--ok)">{{COVERAGE}}</strong> <span data-i18n="pg-main-sub-coverage">cobertura</span> · trace <span class="mono" style="font-size:10px">{{TRACE_ID}}</span></p>
    <div class="hl"></div>
  </div>
  <div class="ex" id="exec-box"><!-- rendered by renderExecSummary() --></div>
  <div class="kg" id="kpi-grid"><!-- renderKPIs() --></div>
  <div class="tc">
    <div class="cd">
      <div class="ch"><h2 data-i18n="card-filetypes">Arquivos por Tipo</h2></div>
      <div class="cb" style="padding:0">
        <table class="at"><thead><tr>
          <th data-i18n="th-type">Tipo</th>
          <th data-i18n="th-qty">Qtd</th>
          <th data-i18n="th-desc">Descrição</th>
        </tr></thead><tbody id="tb-filetypes"></tbody></table>
      </div>
    </div>
    <div class="cd">
      <div class="ch"><h2 data-i18n="card-layers">Estrutura de Camadas</h2></div>
      <div class="cb" style="padding:0">
        <table class="at"><thead><tr>
          <th data-i18n="th-layer">Camada</th><th data-i18n="th-loc">LOC</th>
          <th data-i18n="th-files">Arquivos</th><th data-i18n="th-risk">Risco</th>
        </tr></thead><tbody id="tb-layers"></tbody></table>
      </div>
    </div>
  </div>
</div>

<!-- Riscos ───────────────────────────────────────────────────── -->
<div id="s-risks" class="sec">
  <div class="ph"><h1 data-i18n="pg-risks">Riscos Identificados</h1><div class="hl"></div></div>
  <div class="cd">
    <div class="ch">
      <h2 data-i18n="card-riskregister">Risk Register</h2>
      <span class="ctag bCrit" id="risk-total-tag">0</span>
    </div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th>ID</th><th data-i18n="th-cat">Categoria</th>
        <th data-i18n="th-risk">Risco</th><th data-i18n="th-evidence">Evidência</th>
        <th data-i18n="th-sev">Severidade</th><th data-i18n="th-action">Ação</th>
      </tr></thead><tbody id="tb-risks"></tbody></table>
    </div>
  </div>
</div>

<!-- Fases & Agentes ─────────────────────────────────────────── -->
<div id="s-phases" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-phases">Fases &amp; Status dos Agentes</h1>
    <p data-i18n="pg-phases-sub">41 agentes em 7 frentes · clique numa fase para ver seus agentes e artefatos</p>
    <div class="hl"></div>
  </div>
  <div class="ptl" id="phase-timeline"><!-- renderPhases() --></div>
</div>

<!-- Artefatos ───────────────────────────────────────────────── -->
<div id="s-artifacts" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-artifacts">Todos os Artefatos Gerados</h1>
    <p data-i18n="pg-artifacts-sub">Outputs mapeados de cada agente · clique num chip para ver o caminho completo</p>
    <div class="hl"></div>
  </div>
  <div id="artifact-panels"><!-- renderArtifacts() --></div>
</div>

<!-- Explorer de Arquivos ────────────────────────────────────── -->
<div id="s-file-explorer" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-explorer">Explorer de Arquivos</h1>
    <p data-i18n="pg-explorer-sub">Todos os arquivos em <code>outputs/</code> · filtrar por nome ou extensão</p>
    <div class="hl"></div>
  </div>
  <div class="cd" style="margin-bottom:14px">
    <div class="cb" style="display:flex;align-items:center;gap:10px;padding:10px 16px">
      <span style="font-size:13px;color:var(--g2)">🔍</span>
      <input id="fe-search" type="text"
        data-i18n-placeholder="lbl-filter-placeholder"
        placeholder="Filtrar por nome ou extensão (ex: .md, schema, .cs)"
        oninput="filterFileExplorer(this.value)"
        style="flex:1;background:var(--d3);border:1px solid var(--wb);border-radius:var(--rad);padding:7px 12px;color:var(--fg);font-size:12px;outline:none;transition:border-color var(--tr)"/>
      <span id="fe-count" style="font-size:11px;color:var(--g2);white-space:nowrap"></span>
    </div>
  </div>
  <div id="fe-panels"></div>
</div>

<!-- F1: Arquitetura AS-IS ───────────────────────────────────── -->
<div id="s-f1-arch" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-arch">Arquitetura AS-IS</h1>
    <p>AG-02 · <span class="mono">architecture-blueprint.md · diagrams/c4-*.mmd · pattern-classifications.json</span></p>
    <div class="hl"></div>
  </div>
  <div class="tc">
    <div class="cd">
      <div class="ch"><h2 data-i18n="card-patterns">Padrões Identificados</h2></div>
      <div class="cb" style="padding:0">
        <table class="at"><thead><tr>
          <th data-i18n="th-pattern">Padrão</th><th data-i18n="th-occurs">Ocorrências</th>
          <th>%</th><th data-i18n="th-risk">Risco</th>
        </tr></thead><tbody id="tb-patterns"></tbody></table>
      </div>
    </div>
    <div class="cd">
      <div class="ch"><h2 data-i18n="card-arts-ag02">Artefatos — AG-02</h2></div>
      <div class="cb"><div class="arl" id="chips-ag02"></div></div>
    </div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-c4ctx">C4 Context Diagram</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-c4ctx">{{C4_CONTEXT_DIAGRAM}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-c4cnt">C4 Container Diagram</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-c4cnt">{{C4_CONTAINER_DIAGRAM}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-c4comp">C4 Component Diagram</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-c4comp">{{C4_COMPONENT_DIAGRAM}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-class">Diagrama de Classes (DTOs)</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-class">{{CLASS_DIAGRAM}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-comp">Mapa de Componentes</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-comp">{{COMPONENT_DIAGRAM}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-seq1">Fluxo: Baixa de Título (CP)</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-seq-baixa-cp">{{SEQ_BAIXA_CP}}</pre></div></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="diag-seq2">Fluxo: Cadastro Conta a Pagar</h2><span class="ctag bOk">Mermaid</span></div>
    <div class="cb"><div class="diag-wrap"><pre class="mermaid" id="diag-seq-cad-cp">{{SEQ_CAD_CP}}</pre></div></div>
  </div>
</div>

<!-- F1: Bounded Contexts ────────────────────────────────────── -->
<div id="s-f1-bc" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-bc">Bounded Contexts AS-IS</h1>
    <p>AG-02 · <span class="mono">bounded-context-map.md · pattern-classifications.json</span></p>
    <div class="hl"></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="card-bc">Mapa de Bounded Contexts</h2></div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th data-i18n="th-bc">Bounded Context</th><th data-i18n="th-forms">Forms</th>
        <th data-i18n="th-units">Units</th><th data-i18n="th-loc">LOC</th><th data-i18n="th-risk">Risco</th>
      </tr></thead><tbody id="tb-bc"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Documentação & Requisitos ───────────────────────────── -->
<div id="s-f1-docs" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-docs">Documentação Funcional AS-IS</h1>
    <p>AG-03 · <span class="mono">functional-requirements.md · value-chain.md · business-rules.md</span></p>
    <div class="hl"></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="card-arts-ag03">Artefatos — AG-03</h2></div>
    <div class="cb"><div class="arl" id="chips-ag03"></div></div>
  </div>
  <div class="cd">
    <div class="ch">
      <h2 data-i18n="card-reqs">Requisitos Funcionais</h2>
      <span class="ctag bOk" id="tag-reqs">0 RFs</span>
    </div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th>ID</th><th data-i18n="th-desc">Descrição</th>
        <th data-i18n="th-module">Módulo</th><th data-i18n="th-priority">Prioridade</th>
      </tr></thead><tbody id="tb-reqs"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Regras de Negócio ───────────────────────────────────── -->
<div id="s-f1-rules" class="sec">
  <div class="ph">
