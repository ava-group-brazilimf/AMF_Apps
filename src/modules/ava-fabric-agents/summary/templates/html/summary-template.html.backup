function setLang(l){
  lang = l;
  var dict = I18N[lang] || {};
  /* ── Static text nodes with data-i18n ──────────────────────── */
  document.querySelectorAll('[data-i18n]').forEach(function(el){
    var k = el.getAttribute('data-i18n');
    if(dict[k]) el.textContent = dict[k];
  });
  /* ── Title attributes with data-i18n-title ─────────────────── */
  document.querySelectorAll('[data-i18n-title]').forEach(function(el){
    var k = el.getAttribute('data-i18n-title');
    if(dict[k]) el.setAttribute('title', dict[k]);
  });
  /* ── Placeholder attributes with data-i18n-placeholder ─────── */
  document.querySelectorAll('[data-i18n-placeholder]').forEach(function(el){
    var k = el.getAttribute('data-i18n-placeholder');
    if(dict[k]) el.setAttribute('placeholder', dict[k]);
  });
  /* ── Language label ────────────────────────────────────────── */
  var ll = document.querySelector('.ll');
  if(ll) ll.textContent = l==='en'?'Language / Idioma':'Idioma / Language';
  /* ── html lang attribute ───────────────────────────────────── */
  document.documentElement.lang = l==='en'?'en-US':'pt-BR';
  /* ── Re-render dynamic sections that use t() ───────────────── */
  try { FE_LABELS = FE_LABELS_MAP[lang]||FE_LABELS_MAP.pt; } catch(e){}
  try { renderKPIs(); } catch(e){}
  try { renderFileTypes(); } catch(e){}
  try { renderLayers(); } catch(e){}
  try { renderRisks(); } catch(e){}
  try { renderDBKpis(); } catch(e){}
  try { renderExecSummary(); } catch(e){}
  try { renderSizeKpis(); } catch(e){}
  try { renderParityKpis(); } catch(e){}
  try { renderWaves(); } catch(e){}
  try { renderPhases(); } catch(e){ console.warn('[setLang] renderPhases:', e); }
  try { renderArtifacts(); } catch(e){}
  try { renderFileExplorer(); } catch(e){}
  try { renderQAAgents(); } catch(e){}
  try { renderNavDots(); } catch(e){}
  try { renderCICD(); } catch(e){}
  try { renderChecklistEl('list-qgates', D.qgates); } catch(e){}
  try { renderChecklistEl('list-predelivery', D.qgates); } catch(e){}
  try { renderChecklistEl('list-accept', D.acceptChecklist); } catch(e){}
  try { renderTestPlan(); } catch(e){}
  try { renderOWASP(); } catch(e){}
  try { renderDBSchema(); } catch(e){}
  try { renderInvKpis(); } catch(e){}
  try { renderIaCResources(); } catch(e){}
  try { renderPatterns(); } catch(e){}
  try { renderBC(); } catch(e){}
  try { renderTOBEBC(); } catch(e){}
  try { renderPackages(); } catch(e){}
  try { renderAllChips(); } catch(e){}
  try { renderAllDiagrams(); } catch(e){}
}

/* ── Reusable chip + diagram renderers (called in init + setLang) ── */
const CHIP_MAP = {
  'chips-ag02':'ava-asis-solution-delphi',
  'chips-ag03':'ava-asis-documentation',
  'chips-ag10':'ava-tobe-architecture-design',
  'chips-ag14':'ava-coder-dotnet',
  'chips-ag18':'ava-stack-dotnet-backend',
  'chips-ag19':'ava-stack-angular-frontend',
  'chips-ag20':'ava-prototype',
  'chips-ag25':'ava-qa-script-generator',
  'chips-ag30':'ava-deliverable-packager',
  'chips-ag31':'ava-deliverable-tech-docs',
  'chips-ag36':'ava-deliverable-client-demo',
  'chips-ag37':'ava-devops-iac',
};
function renderAllChips(){
  Object.entries(CHIP_MAP).forEach(([elId, agId])=>renderAgentChips(agId, elId));
}
function renderAllDiagrams(){
  const diagMap = {
    'diag-c4ctx':D.diag.c4ctx, 'diag-c4cnt':D.diag.c4cnt,
    'diag-c4comp':D.diag.c4comp, 'diag-class':D.diag.classDiag,
    'diag-comp':D.diag.compDiag,
    'diag-seq-baixa-cp':D.diag.seqBaixaCP, 'diag-seq-cad-cp':D.diag.seqCadCP,
    'diag-er':D.diag.er, 'diag-tobe-c4':D.diag.tobeC4,
    'diag-gantt':D.diag.gantt, 'diag-solution':D.diag.solution,
    'diag-cleanarch':D.diag.cleanArch,
  };
  Object.entries(diagMap).forEach(([id,v])=>{
    const el = document.getElementById(id);
    if(!el) return;
    const hasContent = v && v.trim() && !v.includes('{{');
    el.textContent = hasContent ? v : t('lbl-no-diagram');
    if(!hasContent) el.classList.add('no-diagram');
  });
}

/* ═══ INIT ════════════════════════════════════════════════════ */
function init(){
  document.getElementById('rpf').style.width = D.execPct + '%';
  renderExecSummary();
  renderKPIs();
  renderFileTypes();
  renderLayers();
  renderRisks();
  renderPatterns();
  renderBC();
  renderTOBEBC();
  renderPackages();
  renderQGates();
  renderWaves();
  renderTestPlan();
  renderOWASP();
  renderDBSchema();
  renderDBKpis();
  renderSizeKpis();
  renderInvKpis();
  renderParityKpis();
  renderCICD();
  renderIaCResources();
  renderPhases();
  renderArtifacts();
  renderFileExplorer();
  renderQAAgents();
  renderNavDots();
  renderChecklistEl('list-qgates', D.qgates);
  renderChecklistEl('list-predelivery', D.qgates);
  renderChecklistEl('list-accept', D.acceptChecklist);

  renderAllChips();
  renderAllDiagrams();

  /* Renderização visual Mermaid.js */
  if(typeof mermaid !== 'undefined'){
    mermaid.initialize({
      startOnLoad: false,
      securityLevel: 'strict',
      wrap: true,
      theme: 'default',
      flowchart:{ useMaxWidth: true, htmlLabels: true },
      classDiagram:{ useMaxWidth: false },
      sequence:{ useMaxWidth: false },
      er:{ useMaxWidth: false },
      c4:{ useMaxWidth: false },
      themeVariables:{
        background:'#ffffff',
        primaryColor:'#FF0000',
        primaryTextColor:'#1a1a1a',
        lineColor:'#444444',
        fontSize:'13px',
      }
    });
    mermaid.run({querySelector:'pre.mermaid:not(.no-diagram)'}).catch(function(e){ console.warn('[Mermaid] render warning:', e.message||e); });
    /* Patch: fix Mermaid bug — negative rect widths cause SVG errors */
    function _patchNegRects(){
      document.querySelectorAll('svg rect').forEach(r=>{
        const w=parseFloat(r.getAttribute('width'));
        if(!isNaN(w)&&w<0){r.setAttribute('width','0'); r.setAttribute('x','0');}
      });
    }
    setTimeout(_patchNegRects, 800);
    setTimeout(_patchNegRects, 2000);
    /* After render, attach zoom handlers */
    setTimeout(setupDiagramZoom, 1000);
  }
}

/* ═══ Diagram Zoom ══════════════════════════════════════════════ */
function setupDiagramZoom(){
  const modal   = document.getElementById('diag-modal');
  const inner   = document.getElementById('diag-modal-inner');
  const content = document.getElementById('diag-modal-content');
  const title   = document.getElementById('diag-modal-title');
  const closeBtn= document.getElementById('diag-modal-close');
  if(!modal) return;

  function openModal(wrap){
    const svg = wrap.querySelector('svg');
    const h2  = wrap.closest('.cd')?.querySelector('h2');
    content.innerHTML = '';
    if(svg){
      content.appendChild(svg.cloneNode(true));
    } else {
      const pre = wrap.querySelector('pre');
      const p = document.createElement('pre');
      p.style.cssText='font-size:13px;white-space:pre;overflow:auto;max-height:80vh;color:#333';
      p.textContent = pre ? pre.textContent : '';
      content.appendChild(p);
    }
    title.textContent = h2 ? h2.textContent : 'Diagrama';
    modal.classList.add('open');
    document.body.style.overflow = 'hidden';
  }

  function closeModal(){
    modal.classList.remove('open');
    document.body.style.overflow = '';
    content.innerHTML = '';
  }

  document.querySelectorAll('.diag-wrap').forEach(wrap=>{
    wrap.addEventListener('click', e=>{
      if(e.target.closest('#diag-modal')) return;
      openModal(wrap);
    });
  });

  closeBtn.addEventListener('click', closeModal);
  modal.addEventListener('click', e=>{
    if(!e.target.closest('#diag-modal-inner')) closeModal();
  });
  document.addEventListener('keydown', e=>{
    if(e.key==='Escape') closeModal();
  });
}

// ── Theme Toggle ─────────────────────────────────────────────
function toggleTheme(){
  const cur=document.documentElement.getAttribute('data-theme')||'light';
  const next=cur==='dark'?'light':'dark';
  document.documentElement.setAttribute('data-theme',next);
  localStorage.setItem('ava-theme',next);
  _syncThemeBtn(next);
}
function _syncThemeBtn(t){
  const icon=document.getElementById('theme-icon');
  const lbl=document.getElementById('theme-lbl');
  if(icon) icon.textContent=t==='dark'?'☀️':'🌙';
  if(lbl) lbl.textContent=t==='dark'?'Claro':'Dark';
}
document.addEventListener('DOMContentLoaded',function(){
  _syncThemeBtn(document.documentElement.getAttribute('data-theme')||'light');
});
document.addEventListener('DOMContentLoaded', init)
document.addEventListener('keydown', e=>{
  if(e.key==='Escape'){
    if(document.getElementById('fc-modal').classList.contains('open')) closeFileContent();
    else closeFileDrawer();
  }
});
</script>

<!-- ═══ Diagram Zoom Modal ════════════════════════════════════ -->
<div id="diag-modal">
  <div id="diag-modal-inner">
    <button id="diag-modal-close" title="Fechar (ESC)">✕</button>
    <div id="diag-modal-title"></div>
    <div id="diag-modal-content"></div>
  </div>
</div>
</body>
</html>
