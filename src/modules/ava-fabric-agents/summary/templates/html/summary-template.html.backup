    {l:"Tabelas",               k:"dbk-tables",  v:"{{TABLE_COUNT}}",  c:""},
    {l:"Stored Procedures",     k:"dbk-sps",     v:"{{SP_COUNT}}",     c:"a"},
    {l:"SPs com Regra Negócio", k:"dbk-biz-sps", v:"{{SP_BIZ_COUNT}}", c:"r"},
