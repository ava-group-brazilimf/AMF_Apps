    {n:"DataModule (Repository implícito)",o:"{{P2_COUNT}}", p:"{{P2_PCT}}", r:"medio"},
    {n:"Two-Tier (SQL inline)",            o:"{{P3_COUNT}}", p:"{{P3_PCT}}", r:"alto"},
    {n:"Business Logic in SP",             o:"{{P4_COUNT}}", p:"{{P4_PCT}}", r:"critico"},
    {n:"Rich Domain (units isoladas)",     o:"{{P5_COUNT}}", p:"{{P5_PCT}}", r:"baixo"},
  ],

  /* ── Bounded contexts (AG-02 bounded-context-map.md) ─────────── */
  bc:[
