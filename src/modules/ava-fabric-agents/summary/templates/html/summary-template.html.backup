    {t:"Integration",   tool:"Testcontainers",          alvo:"Infrastructure + API",    crit:"Coverage ≥ 70%",              cov:"{{IT_COV}}%"},
    {t:"Load Tests",    tool:"k6",                      alvo:"Endpoints críticos",      crit:"p95 ≤ AS-IS baseline",        cov:"—"},
    {t:"Functional",    tool:"xUnit (data-driven)",     alvo:"Business rules mapeadas", crit:"100% RNs cobertas",           cov:"{{FT_COV}}%"},
    {t:"UI Tests",      tool:"Playwright",              alvo:"Jornadas críticas Angular",crit:"Happy path + edge cases",    cov:"{{UI_COV}}%"},
    {t:"Parity Tests",  tool:"ava-devops-compare-version",alvo:"Todos os módulos",      crit:"≥ 99.5% equivalência",       cov:"{{PAR_COV}}%"},
  ],

  /* ── OWASP findings (AG-05 security-map.md) ─────────────────── */
  owasp:[
