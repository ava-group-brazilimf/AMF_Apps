    <p>AG-03 · <span class="mono">docs/business-rules.md</span></p>
    <div class="hl"></div>
  </div>
  <div class="cd">
    <div class="ch">
      <h2 data-i18n="card-rules">Mapeamento de Regras</h2>
      <span class="ctag bOk" id="tag-rules">0 RNs</span>
    </div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th>ID</th><th data-i18n="th-rule">Regra</th>
        <th data-i18n="th-module">Módulo</th>
        <th data-i18n="th-origin">Origem (arquivo:linha)</th>
        <th data-i18n="th-priority">Prioridade</th>
      </tr></thead><tbody id="tb-rules"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Fluxo de Telas ──────────────────────────────────────── -->
<div id="s-f1-screens" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-screens">Fluxo de Telas</h1>
    <p>AG-03 · <span class="mono">screen-navigation-map.md · screen-rules.md · prototype-asis/</span></p>
    <div class="hl"></div>
  </div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="card-navmap">Mapa de Navegação</h2></div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th data-i18n="th-screen">Tela / Form</th>
        <th data-i18n="th-module">Módulo</th>
        <th data-i18n="th-from">Vem de</th>
        <th data-i18n="th-to">Vai para</th>
        <th data-i18n="th-rules">Regras</th>
      </tr></thead><tbody id="tb-screens"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Inventário & Métricas ───────────────────────────────── -->
<div id="s-f1-inv" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-inv">Inventário &amp; Métricas</h1>
    <p>AG-06 · <span class="mono">inventory-report.md · metrics.json · complexity-map.md</span></p>
    <div class="hl"></div>
  </div>
  <div class="kg" id="kpi-inv"><!-- renderInvKpis() --></div>
  <div class="cd">
    <div class="ch"><h2 data-i18n="card-complexity"> — Complexidade Ciclomática</h2></div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th>#</th><th data-i18n="th-file">Arquivo</th>
        <th data-i18n="th-method">Método</th><th data-i18n="th-cc">CC</th>
      </tr></thead><tbody id="tb-complexity"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Security Review ─────────────────────────────────────── -->
<div id="s-f1-sec" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-secreview">Security Review AS-IS</h1>
    <p>AG-05 · <span class="mono">security-map.md · vulnerabilities.md · compliance-gaps.md</span></p>
    <div class="hl"></div>
  </div>
  <div class="cd">
    <div class="ch">
      <h2 data-i18n="card-owasp">OWASP Assessment</h2>
      <span class="ctag bCrit" id="tag-owasp">0 findings</span>
    </div>
    <div class="cb" style="padding:0">
      <table class="at"><thead><tr>
        <th>OWASP</th><th data-i18n="th-finding">Finding</th>
        <th data-i18n="th-evidence">Evidência</th>
        <th data-i18n="th-sev">Severidade</th><th data-i18n="th-action">Ação</th>
      </tr></thead><tbody id="tb-owasp"></tbody></table>
    </div>
  </div>
</div>

<!-- F1: Test Baseline ───────────────────────────────────────── -->
<div id="s-f1-qa" class="sec">
  <div class="ph">
    <h1 data-i18n="pg-testbaseline">Test Baseline AS-IS</h1>
    <p>AG-04 · <span class="mono">test-map.md · test-baseline.md · test-gaps.md · test-coverage-asis.md</span></p>
    <div class="hl"></div>
  </div>
  <div class="tc">
    <div class="cd">
      <div class="ch"><h2 data-i18n="card-testmap">Testes Existentes</h2></div>
      <div class="cb" style="padding:0">
        <table class="at"><thead><tr>
          <th data-i18n="th-module">Módulo</th><th data-i18n="th-tests">Testes</th>
