    {l:"Team Size",          k:"szk-team",       v:"{{TEAM_SIZE}}",    c:"",  s:"devs recomendados", sk:"szk-team-sub"},
    {l:"Custo Azure/mês",    k:"szk-azure-cost", v:"{{AZURE_COST}}",   c:"g", s:"ambiente produção", sk:"szk-cost-sub"},
