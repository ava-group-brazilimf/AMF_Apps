    {n:"{{BC2_NAME}}", forms:"{{BC2_FORMS}}", units:"{{BC2_UNITS}}", loc:"{{BC2_LOC}}", r:"{{BC2_RISK}}"},
    {n:"{{BC3_NAME}}", forms:"{{BC3_FORMS}}", units:"{{BC3_UNITS}}", loc:"{{BC3_LOC}}", r:"{{BC3_RISK}}"},
  ],

  /* ── DB schema (AG-08 schema-inventory.md) ──────────────────── */
  dbKpis:[
